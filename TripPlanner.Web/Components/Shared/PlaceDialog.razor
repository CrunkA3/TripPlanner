    private void UpdateEditorState(GpxEditorState? state)
    {
        if (state is null) return;
        _editorRoutePoints = (state.Points ?? [])
            .OrderBy(p => p.Order)
            .Select((p, idx) => new GpxEditorPoint
            {
                Latitude = p.Latitude,
                Longitude = p.Longitude,
                Order = idx + 1
            })
            .ToList();

        _editorWaypoints = (state.Waypoints ?? [])
            .OrderBy(w => w.Order)
            .Select((w, idx) => new GpxEditorWaypoint
            {
                Id = string.IsNullOrWhiteSpace(w.Id) ? Guid.NewGuid().ToString() : w.Id,
                Name = w.Name ?? string.Empty,
                Latitude = w.Latitude,
                Longitude = w.Longitude,
                Order = idx + 1
            })
            .ToList();
        ReorderEditedWaypoints();
        InvokeAsync(StateHasChanged);
    }

    private void ReorderEditedWaypoints()
    {
        for (var i = 0; i < _editorWaypoints.Count; i++)
            _editorWaypoints[i].Order = i + 1;
    }

    private async Task ImportGpxFromUrl(string gpxUrl)
    {
        if (Content == null || _isImportingGpx) return;

        // Validate that the URL uses a safe, fetchable scheme.
        if (!Uri.TryCreate(gpxUrl, UriKind.Absolute, out var parsedUri) ||
            (parsedUri.Scheme != Uri.UriSchemeHttp && parsedUri.Scheme != Uri.UriSchemeHttps))
        {
            _gpxImportError = "GPX URL must use http or https.";
            return;
        }

        if (UrlSecurityHelper.IsPrivateOrLocalUri(parsedUri))
        {
            _gpxImportError = "Private or local URLs are not allowed.";
            return;
        }

        _isImportingGpx = true;
        _importingGpxUrl = gpxUrl;
        _gpxImportError = null;

        const long maxGpxBytes = 10 * 1024 * 1024; // 10 MB – matches GpxFileUpload limit

        try
        {
            using var client = HttpClientFactory.CreateClient("UrlFetchNoRedirect");
            var fetchUri = parsedUri;

            // Manually follow up to 5 redirects, validating each Location against SSRF rules
            HttpResponseMessage response;
            int redirects = 0;
            while (true)
            {
                response = await client.GetAsync(fetchUri, HttpCompletionOption.ResponseHeadersRead);

                if (response.StatusCode is System.Net.HttpStatusCode.MovedPermanently
                                         or System.Net.HttpStatusCode.Found
                                         or System.Net.HttpStatusCode.SeeOther
                                         or System.Net.HttpStatusCode.TemporaryRedirect
                                         or System.Net.HttpStatusCode.PermanentRedirect)
                {
                    if (++redirects > 5 || response.Headers.Location is not { } location)
                        break;

                    var next = location.IsAbsoluteUri ? location : new Uri(fetchUri, location);
                    if ((next.Scheme != Uri.UriSchemeHttp && next.Scheme != Uri.UriSchemeHttps)
                        || UrlSecurityHelper.IsPrivateOrLocalUri(next))
                    {
                        _gpxImportError = "Private or local URLs are not allowed.";
                        return;
                    }

                    fetchUri = next;
                    continue;
                }

                break;
            }

            response.EnsureSuccessStatusCode();

            // Reject responses that are obviously not GPX/XML (e.g. an HTML error page)
            var contentType = response.Content.Headers.ContentType?.MediaType ?? string.Empty;
            if (contentType.Contains("text/html", StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("The URL did not return a GPX file.");

            // Reject content that exceeds the size limit based on the Content-Length header.
            if (response.Content.Headers.ContentLength > maxGpxBytes)
                throw new InvalidOperationException("GPX file is too large (maximum 10 MB).");

            // Stream-read the response body with a hard cap to guard against missing Content-Length.
            using var responseStream = await response.Content.ReadAsStreamAsync();
            using var ms = new MemoryStream();
            var buffer = new byte[8192];
            long totalRead = 0;
            int bytesRead;
            while ((bytesRead = await responseStream.ReadAsync(buffer)) > 0)
            {
                totalRead += bytesRead;
                if (totalRead > maxGpxBytes)
                    throw new InvalidOperationException("GPX file is too large (maximum 10 MB).");
                await ms.WriteAsync(buffer.AsMemory(0, bytesRead));
            }
            var gpxContent = Encoding.UTF8.GetString(ms.ToArray());

            var fn = Path.GetFileName(parsedUri.LocalPath);
            var fileName = !string.IsNullOrEmpty(fn) ? fn : "track.gpx";

            var gpxTrack = GpxService.ParseGpxContent(gpxContent, fileName);
            gpxTrack.CreatedAt = DateTimeOffset.UtcNow;

            await GpxRepository.AddAsync(gpxTrack);

            Content.GpxTrackId = gpxTrack.Id;
            Content.Latitude = gpxTrack.Points.FirstOrDefault()?.Latitude ?? Content.Latitude;
            Content.Longitude = gpxTrack.Points.FirstOrDefault()?.Longitude ?? Content.Longitude;

            await LoadGpxTracks();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to import GPX from URL: {Url}", gpxUrl);
            _gpxImportError = $"Could not import GPX file: {ex.Message}";
        }
        finally
        {
            _isImportingGpx = false;
            _importingGpxUrl = null;
        }
    }



    private async Task AnalyzeUrl()
    {
        if (string.IsNullOrWhiteSpace(Content.Url)) return;

        if (!Uri.TryCreate(Content.Url, UriKind.Absolute, out var uri) ||
            (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            _analyzeError = "Please enter a valid http or https URL to analyze.";
            return;
        }

        if (UrlSecurityHelper.IsPrivateOrLocalUri(uri))
        {
            _analyzeError = "Private or local URLs are not allowed.";
            return;
        }

        _isAnalyzing = true;
        _analyzeError = null;
        _suggestion = null;
        _foundGpxUrls = [];
        StateHasChanged();

        try
        {
            var result = await PlaceAnalysisService.AnalyzeUrlAsync(Content.Url, BrowserTimeZoneService.LanguageTag);
            _suggestion = result?.Suggestion;
            _foundGpxUrls = result?.GpxFileUrls ?? [];
            if (_suggestion == null)
                _analyzeError = "The AI could not extract place information from this URL.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "URL analysis failed for: {Url}", Content.Url);
            _analyzeError = "Failed to analyze the URL. Please check that the address is accessible and try again.";
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged();
        }
    }

    private void ApplySuggestion()
    {
        if (_suggestion == null || Content == null) return;

        if (!string.IsNullOrEmpty(_suggestion.Name))
            Content.Name = _suggestion.Name;

        if (!string.IsNullOrEmpty(_suggestion.Description))
            Content.Description = _suggestion.Description;

        if (!string.IsNullOrEmpty(_suggestion.Category) &&
            Enum.TryParse<PlaceCategory>(_suggestion.Category, ignoreCase: true, out var cat))
        {
            Content.Category = cat;
            _newPlaceCategoryString = cat.ToString();
        }

        if (_suggestion.Latitude.HasValue)
            Content.Latitude = _suggestion.Latitude.Value;

        if (_suggestion.Longitude.HasValue)
            Content.Longitude = _suggestion.Longitude.Value;

        if (_suggestion.Tags.Count > 0)
            SelectedTags = _suggestion.Tags;

        _suggestion = null;
    }

