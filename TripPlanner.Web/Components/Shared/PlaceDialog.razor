    private async Task SaveEditedRoute()
    {
        _routeEditorError = null;
        if (_routeEditorInitialized)
        {
            var data = await JS.InvokeAsync<GpxEditorState>("gpxRouteEditor.getData", _routeEditorId);
            UpdateEditorState(data);
        }

        if (_editorRoutePoints.Count < 2)
        {
            _routeEditorError = "Please set at least two route points.";
            return;
        }

        var track = new GpxTrack
        {
            Id = Content.GpxTrackId ?? Guid.NewGuid().ToString(),
            Name = string.IsNullOrWhiteSpace(Content.Name) ? "Route" : $"{Content.Name} Route",
            Description = $"Route for {Content.Name}",
            CreatedAt = DateTimeOffset.UtcNow,
            Points = _editorRoutePoints
                .OrderBy(p => p.Order)
                .Select(p => new GpxPoint
                {
                    GpxTrackId = Content.GpxTrackId ?? string.Empty,
                    Latitude = p.Latitude,
                    Longitude = p.Longitude,
                    Order = p.Order
                })
                .ToList(),
            Waypoints = _editorWaypoints
                .OrderBy(w => w.Order)
                .Select(w => new GpxWaypoint
                {
                    Id = string.IsNullOrWhiteSpace(w.Id) ? Guid.NewGuid().ToString() : w.Id,
                    GpxTrackId = Content.GpxTrackId ?? string.Empty,
                    Name = w.Name,
                    Latitude = w.Latitude,
                    Longitude = w.Longitude,
                    Order = w.Order
                })
                .ToList()
        };

        // Ensure FK values point to the final track ID
        foreach (var point in track.Points)
            point.GpxTrackId = track.Id;
        foreach (var waypoint in track.Waypoints)
            waypoint.GpxTrackId = track.Id;

        // Keep statistics aligned with current route points
        var totalDistance = 0d;
        for (var i = 1; i < track.Points.Count; i++)
        {
            totalDistance += GpxService.CalculateDistance(
                track.Points[i - 1].Latitude, track.Points[i - 1].Longitude,
                track.Points[i].Latitude, track.Points[i].Longitude);
        }
        track.TotalDistance = totalDistance;

        if (string.IsNullOrEmpty(Content.GpxTrackId))
        {
            await GpxRepository.AddAsync(track);
            Content.GpxTrackId = track.Id;
        }
        else
        {
            var userId = await UserService.GetCurrentUserIdAsync();
            if (string.IsNullOrEmpty(userId))
            {
                _routeEditorError = "You must be signed in to update this route.";
                return;
            }

            var updated = await GpxRepository.UpdateAsync(track, userId);
            if (updated is null)
            {
                _routeEditorError = "You don't have permission to update this route.";
                return;
            }
        }

        Content.Latitude = track.Points[0].Latitude;
        Content.Longitude = track.Points[0].Longitude;

        await LoadGpxTracks();
        await CloseRouteEditor();
    }

    private async Task CloseRouteEditor()
    {
        _routeEditorError = null;
        _isAddWaypointMode = false;
        _isRouteEditorOpen = false;
        if (_routeEditorInitialized)
        {
            await JS.InvokeVoidAsync("gpxRouteEditor.destroy", _routeEditorId);
            _routeEditorInitialized = false;
        }
    }

