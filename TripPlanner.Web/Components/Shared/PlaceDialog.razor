@implements IDialogContentComponent<Place>
@implements IAsyncDisposable

@using System.Text
@using Microsoft.JSInterop
@using TripPlanner.Web.Models
@using TripPlanner.Web.Repositories
@using TripPlanner.Web.Services
@using static TripPlanner.Web.Components.Shared.GpxFileUpload

@inject IWishlistRepository WishlistRepository
@inject IPlaceRepository PlaceRepository
@inject IGpxRepository GpxRepository
@inject IHttpClientFactory HttpClientFactory
@inject UserService UserService
@inject GpxService GpxService
@inject IPlaceAnalysisService PlaceAnalysisService
@inject BrowserTimeZoneService BrowserTimeZoneService


<FluentDialogHeader>
    <FluentLabel Typo="Typography.PaneHeader">@(Dialog.Instance.Parameters.Title ?? "Add Place")</FluentLabel>
</FluentDialogHeader>
<FluentDialogBody>
    @if (Content != null)
    {
        <FluentTabs>
            <FluentTab Label="Details" Icon="@(new Icons.Regular.Size16.Info())">
                <FluentStack Orientation="Orientation.Vertical" Style="padding: 8px 0;">
                    @if (string.IsNullOrEmpty(Content.WishlistId) && string.IsNullOrEmpty(Content.TripId))
                    {
                        <FluentSelect TOption="Wishlist"
                                      Placeholder="Select wishlist..."
                                      Label="Wishlist"
                                      Items="Wishlists"
                                      OptionValue="@(wl => wl.Id)"
                                      OptionText="@(wl => wl.Name)"
                                      Style="width: 100%;"
                                      @bind-Value="SelectedWishlistId"
                                      Required />
                    }
                    <FluentTextField @bind-Value="@Content.Url" Label="Link (URL)" Style="width: 100%;" Placeholder="https://example.com" />
                    @if (!string.IsNullOrEmpty(_urlError))
                    {
                        <FluentLabel Color="Color.Error" Style="font-size: 0.875em;">@_urlError</FluentLabel>
                    }
                    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; align-items: center;">
                        <FluentButton Appearance="Appearance.Outline"
                                      OnClick="@AnalyzeUrl"
                                      Disabled="@(string.IsNullOrWhiteSpace(Content.Url) || _isAnalyzing)"
                                      Style="white-space: nowrap;">
                            @if (_isAnalyzing)
                            {
                                <FluentProgress Circular Value="null" Width="14px" Style="margin-right: 4px;" />
                            }
                            @(_isAnalyzing ? "Analyzing…" : "✨ Analyze with AI")
                        </FluentButton>
                        @if (!string.IsNullOrEmpty(_analyzeError))
                        {
                            <FluentLabel Color="Color.Error" Style="font-size: 0.875em; flex: 1;">@_analyzeError</FluentLabel>
                        }
                    </FluentStack>
                    @if (_suggestion != null)
                    {
                        <FluentCard Style="padding: 12px; background: var(--neutral-fill-rest); border: 1px solid var(--accent-fill-rest);">
                            <FluentStack Orientation="Orientation.Vertical" Style="gap: 6px;">
                                <FluentLabel Weight="FontWeight.Bold" Style="font-size: 0.95em;">AI Suggestion</FluentLabel>
                                @if (!string.IsNullOrEmpty(_suggestion.Name))
                                {
                                    <FluentLabel Style="font-size: 0.875em;"><b>Name:</b> @_suggestion.Name</FluentLabel>
                                }
                                @if (!string.IsNullOrEmpty(_suggestion.Description))
                                {
                                    <FluentLabel Style="font-size: 0.875em;"><b>Description:</b> @_suggestion.Description</FluentLabel>
                                }
                                @if (!string.IsNullOrEmpty(_suggestion.Category))
                                {
                                    <FluentLabel Style="font-size: 0.875em;"><b>Category:</b> @_suggestion.Category</FluentLabel>
                                }
                                @if (_suggestion.Latitude.HasValue && _suggestion.Longitude.HasValue)
                                {
                                    <FluentLabel Style="font-size: 0.875em;"><b>Coordinates:</b> @_suggestion.Latitude.Value.ToString("F4"), @_suggestion.Longitude.Value.ToString("F4")</FluentLabel>
                                }
                                @if (_suggestion.Tags.Any())
                                {
                                    <FluentLabel Style="font-size: 0.875em;"><b>Tags:</b> @string.Join(", ", _suggestion.Tags)</FluentLabel>
                                }
                                <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; margin-top: 4px;">
                                    <FluentButton Appearance="Appearance.Accent" OnClick="@ApplySuggestion">Apply</FluentButton>
                                    <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => _suggestion = null)">Dismiss</FluentButton>
                                </FluentStack>
                            </FluentStack>
                        </FluentCard>
                    }
                    <FluentTextField @bind-Value="@Content.Name" Label="Name" Required Style="width: 100%;" data-testid="place-name" />
                    <FluentTextArea @bind-Value="@Content.Description" Label="Description" Rows="3" Style="width: 100%;" data-testid="place-description" />
                    <FluentSelect TOption="string" Value="@_newPlaceCategoryString" Label="Category" Style="width: 100%;" ValueChanged="@OnNewPlaceCategoryChanged">
                        @foreach (var category in Enum.GetValues<PlaceCategory>())
                        {
                            <FluentOption TOption="string" Value="@category.ToString()">@category.ToString()</FluentOption>
                        }
                    </FluentSelect>
                    <FluentAutocomplete TOption="string" Label="Tags" OnOptionsSearch="@OnTagSearchAsync" @bind-SelectedOptions="@SelectedTags" />
                    <FluentStack Orientation="Orientation.Horizontal" Style="width: 100%; gap: 8px;">
                        <FluentNumberField @bind-Value="@Content.Latitude" Label="Latitude" Step="0.0001" Style="flex: 1;" data-testid="place-latitude" />
                        <FluentNumberField @bind-Value="@Content.Longitude" Label="Longitude" Step="0.0001" Style="flex: 1;" data-testid="place-longitude" />
                    </FluentStack>
                </FluentStack>
            </FluentTab>

            <FluentTab Label="Schedule" Icon="@(new Icons.Regular.Size16.CalendarLtr())">
                <FluentStack Orientation="Orientation.Vertical" Style="padding: 8px 0;">
                    <FluentStack Orientation="Orientation.Horizontal" Style="width: 100%; gap: 8px;">
                        <FluentDatePicker Label="Start Date" Value="@Content.VisitDate?.DateTime" ValueChanged="@(d => Content.VisitDate = d.HasValue ? (DateTimeOffset?)new DateTimeOffset(d.Value.Date + (Content.VisitDate?.TimeOfDay ?? TimeSpan.Zero), Content.VisitDate?.Offset ?? TimeSpan.Zero) : null)" Style="flex: 1;" />
                        <FluentTimePicker Label="Start Time" Value="@Content.VisitDate?.DateTime" ValueChanged="@(t => Content.VisitDate = t.HasValue ? (DateTimeOffset?)new DateTimeOffset((Content.VisitDate?.Date ?? DateTime.Today) + t.Value.TimeOfDay, Content.VisitDate?.Offset ?? TimeSpan.Zero) : null)" Style="flex: 1;" />
                    </FluentStack>
                    <FluentStack Orientation="Orientation.Horizontal" Style="width: 100%; gap: 8px;">
                        <FluentDatePicker Label="End Date" Value="@Content.VisitDateEnd?.DateTime" ValueChanged="@(d => Content.VisitDateEnd = d.HasValue ? (DateTimeOffset?)new DateTimeOffset(d.Value.Date + (Content.VisitDateEnd?.TimeOfDay ?? TimeSpan.Zero), Content.VisitDateEnd?.Offset ?? TimeSpan.Zero) : null)" Style="flex: 1;" />
                        <FluentTimePicker Label="End Time" Value="@Content.VisitDateEnd?.DateTime" ValueChanged="@(t => Content.VisitDateEnd = t.HasValue ? (DateTimeOffset?)new DateTimeOffset((Content.VisitDateEnd?.Date ?? DateTime.Today) + t.Value.TimeOfDay, Content.VisitDateEnd?.Offset ?? TimeSpan.Zero) : null)" Style="flex: 1;" />
                    </FluentStack>
                    @if (Content.VisitDate.HasValue && Content.VisitDateEnd.HasValue && Content.VisitDateEnd < Content.VisitDate)
                    {
                        <FluentLabel Color="Color.Error" Style="font-size: 0.875em;">Visit end date must be on or after the start date.</FluentLabel>
                    }
                </FluentStack>
            </FluentTab>

            <FluentTab Label="Images" Icon="@(new Icons.Regular.Size16.Image())">
                <FluentStack Orientation="Orientation.Vertical" Style="padding: 8px 0;">
                    @if (Content.Images.Any())
                    {
                        <FluentStack Orientation="Orientation.Horizontal" Style="flex-wrap: wrap; gap: 8px;">
                            @{
                                var sortedImages = Content.Images.OrderBy(i => i.SortOrder).ToList();
                            }
                            @for (var idx = 0; idx < sortedImages.Count; idx++)
                            {
                                var img = sortedImages[idx];
                                var capturedIdx = idx;
                                <div style="position: relative; display: inline-block;">
                                    <img src="@GetImageSrc(img)"
                                         srcset="@PlaceImageHelper.GetSrcSet(img)"
                                         sizes="120px"
                                         alt="Place image"
                                         style="width: 120px; height: 90px; object-fit: cover; border-radius: 4px; cursor: pointer;"
                                         @onclick="@(() => OpenLightbox(capturedIdx))" />
                                    <FluentButton Appearance="Appearance.Lightweight"
                                                  Style="position: absolute; top: 2px; right: 2px; padding: 2px; min-width: unset;"
                                                  OnClick="@(() => RemoveImage(img))">
                                        <FluentIcon Value="@(new Icons.Regular.Size12.Dismiss())" />
                                    </FluentButton>
                                </div>
                            }
                        </FluentStack>
                    }
                    else
                    {
                        <FluentLabel Style="font-size: 0.875em; color: var(--neutral-foreground-hint);">No images yet. Add one below.</FluentLabel>
                    }
                    <FluentDivider Role="DividerRole.Separator" />
                    <FluentStack Orientation="Orientation.Horizontal" Style="width: 100%; gap: 8px;">
                        <FluentTextField @bind-Value="@_imageUrl" Label="Image URL" Style="flex: 1;" Placeholder="https://example.com/image.jpg" />
                        <FluentButton Appearance="Appearance.Lightweight" OnClick="@DownloadImageFromUrl" Style="align-self: flex-end;">Download</FluentButton>
                    </FluentStack>
                    @if (!string.IsNullOrEmpty(_imageError))
                    {
                        <FluentLabel Color="Color.Error">@_imageError</FluentLabel>
                    }
                    <FluentLabel Style="font-size: 0.875em; color: var(--neutral-foreground-hint);">Or upload from device:</FluentLabel>
                    <InputFile id="@_fileInputId" OnChange="@HandleFileSelected" accept="image/*" style="display: none;" multiple />
                    <FluentButton Appearance="Appearance.Outline" OnClick="@TriggerFileInput">Browse</FluentButton>
                </FluentStack>
            </FluentTab>

            <FluentTab Label="GPX" Icon="@(new Icons.Regular.Size16.Location())">
                <FluentStack Orientation="Orientation.Vertical" Style="padding: 8px 0;">
                    @if (!_isRouteEditorOpen && !string.IsNullOrEmpty(Content.GpxTrackId))
                    {
                        var gpxTrack = GpxTracks.FirstOrDefault(g => g.Id == Content.GpxTrackId);
                        @if (gpxTrack != null)
                        {
                            <FluentCard>
                                <FluentStack Orientation="Orientation.Horizontal">
                                    <FluentIcon Icon="Icons.Regular.Size20.Location" Color="Color.Accent" />
                                    <FluentStack Orientation="Orientation.Vertical" Style="flex: 1;">
                                        <FluentLabel Weight="FontWeight.Bold">@gpxTrack.Name</FluentLabel>
                                        <FluentLabel Style="font-size: 0.875em;">
                                            Distance: @gpxTrack.TotalDistance.ToString("F2") km | Points: @gpxTrack.Points.Count | Waypoints: @gpxTrack.Waypoints.Count
                                        </FluentLabel>
                                    </FluentStack>
                                    <FluentButton Appearance="Appearance.Outline"
                                                  IconStart="@(new Icons.Regular.Size16.Edit())"
                                                  OnClick="@OpenRouteEditor">
                                        Edit route
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Lightweight" IconStart="@(new Icons.Regular.Size16.Delete())" OnClick="@RemoveGpxTrack">
                                    </FluentButton>
                                </FluentStack>
                            </FluentCard>
                        }
                    }
                    else if (!_isRouteEditorOpen)
                    {
                        <FluentLabel Style="font-size: 0.875em; color: var(--neutral-foreground-hint);">No GPX track attached. Upload one below.</FluentLabel>
                        <FluentButton Appearance="Appearance.Outline"
                                      IconStart="@(new Icons.Regular.Size16.Edit())"
                                      OnClick="@OpenRouteEditor">
                            Create route on map
                        </FluentButton>
                        @if (_foundGpxUrls.Count > 0)
                        {
                            <FluentLabel Weight="FontWeight.Bold" Style="font-size: 0.875em;">Found on page:</FluentLabel>
                            @foreach (var gpxUrl in _foundGpxUrls)
                            {
                                var capturedUrl = gpxUrl;
                                var isThisImporting = _importingGpxUrl == capturedUrl;
                                <FluentCard Style="padding: 8px;">
                                    <FluentStack Orientation="Orientation.Horizontal" Style="align-items: center; gap: 8px;">
                                        <FluentIcon Icon="Icons.Regular.Size20.Location" Color="Color.Neutral" />
                                        <FluentLabel Style="font-size: 0.8em; flex: 1; word-break: break-all;">@capturedUrl</FluentLabel>
                                        <FluentButton Appearance="Appearance.Outline"
                                                      Disabled="@_isImportingGpx"
                                                      OnClick="@(() => ImportGpxFromUrl(capturedUrl))">
                                            @if (isThisImporting)
                                            {
                                                <FluentProgress Circular Value="null" Width="14px" Style="margin-right: 4px;" />
                                            }
                                            Import
                                        </FluentButton>
                                    </FluentStack>
                                </FluentCard>
                            }
                            @if (!string.IsNullOrEmpty(_gpxImportError))
                            {
                                <FluentLabel Color="Color.Error" Style="font-size: 0.875em;">@_gpxImportError</FluentLabel>
                            }
                            <FluentDivider />
                        }
                        <GpxFileUpload OnFileUploaded="@HandleGpxUploaded" />
                    }

                    @if (_isRouteEditorOpen)
                    {
                        <FluentCard>
                            <FluentStack Orientation="Orientation.Vertical" Style="gap: 10px;">
                                <FluentLabel Weight="FontWeight.Bold">Route editor</FluentLabel>
                                <FluentLabel Style="font-size: 0.875em; color: var(--neutral-foreground-hint);">
                                    Click/touch map to add points, drag points to move them, and click blue midpoint handles to insert in-between points.
                                </FluentLabel>
                                <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; flex-wrap: wrap;">
                                    <FluentButton Appearance="@(_isAddWaypointMode ? Appearance.Accent : Appearance.Outline)"
                                                  IconStart="@(new Icons.Regular.Size16.Pin())"
                                                  OnClick="@ToggleAddWaypointMode">
                                        Waypoint mode
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Outline"
                                                  IconStart="@(new Icons.Regular.Size16.Pin())"
                                                  OnClick="@AddWaypointAtMapCenter">
                                        Add waypoint at center
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Neutral"
                                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                                  OnClick="@ClearEditedRoute">
                                        Clear route
                                    </FluentButton>
                                </FluentStack>
                                <div id="@_routeEditorMapId" style="width: 100%; height: 320px; border-radius: 8px; overflow: hidden; border: 1px solid var(--neutral-stroke-rest);"></div>
                                <FluentLabel Style="font-size: 0.875em;">
                                    Route points: @_editorRoutePoints.Count | Waypoints: @_editorWaypoints.Count
                                </FluentLabel>
                                @if (!string.IsNullOrEmpty(_routeEditorError))
                                {
                                    <FluentLabel Color="Color.Error" Style="font-size: 0.875em;">@_routeEditorError</FluentLabel>
                                }

                                @if (_editorWaypoints.Count > 0)
                                {
                                    <FluentStack Orientation="Orientation.Vertical" Style="gap: 6px;">
                                        @foreach (var waypoint in _editorWaypoints.OrderBy(w => w.Order))
                                        {
                                            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; align-items: flex-end;">
                                                <FluentTextField Value="@waypoint.Name"
                                                                 ValueChanged="@((value) => OnWaypointNameChanged(waypoint.Id, value))"
                                                                 Label="@($"Waypoint {waypoint.Order}")"
                                                                 Style="flex: 1;" />
                                                <FluentLabel Style="font-size: 0.8em; min-width: 180px;">
                                                    @waypoint.Latitude.ToString("F5"), @waypoint.Longitude.ToString("F5")
                                                </FluentLabel>
                                                <FluentButton Appearance="Appearance.Lightweight"
                                                              IconStart="@(new Icons.Regular.Size16.Delete())"
                                                              OnClick="@(() => RemoveWaypointFromEditor(waypoint.Id))" />
                                            </FluentStack>
                                        }
                                    </FluentStack>
                                }

                                <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px;">
                                    <FluentButton Appearance="Appearance.Accent" OnClick="@SaveEditedRoute">
                                        Save route
                                    </FluentButton>
                                    <FluentButton Appearance="Appearance.Neutral" OnClick="@CloseRouteEditor">
                                        Cancel
                                    </FluentButton>
                                </FluentStack>
                            </FluentStack>
                        </FluentCard>
                    }
                </FluentStack>
            </FluentTab>
        </FluentTabs>
    }
    @if (!string.IsNullOrEmpty(_saveError))
    {
        <FluentLabel Color="Color.Error" Style="font-size: 0.875em; margin-top: 8px;">@_saveError</FluentLabel>
    }
</FluentDialogBody>
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Accent" OnClick="@SavePlace" data-testid="save-place-button">Save</FluentButton>
    <FluentButton Appearance="Appearance.Neutral" OnClick="@CancelAsync">Cancel</FluentButton>
</FluentDialogFooter>

<PlaceLightbox Place="Content"
               InitialIndex="@_lightboxIndex"
               IsOpen="@(_lightboxIndex >= 0)"
               IsOpenChanged="@OnLightboxIsOpenChanged" />

@code {
    [Parameter]
    public Place Content { get; set; } = default!;
    private string _newPlaceCategoryString = string.Empty;

    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;

    private List<Wishlist>? Wishlists { get; set; }
    string? SelectedWishlistId { get; set; }

    private List<GpxTrack> GpxTracks { get; set; } = new();
    private IEnumerable<string> Tags { get; set; } = Array.Empty<string>();
    private IEnumerable<string> SelectedTags { get; set; } = Array.Empty<string>();

    private string _imageUrl = string.Empty;
    private string? _imageError;
    private string? _urlError;
    private string? _saveError;
    private string _fileInputId = $"img-upload-{Guid.NewGuid():N}";
    private const long MaxImageSizeBytes = 5 * 1024 * 1024;
    private const int MaxImageCount = 10;

    private int _lightboxIndex = -1;

    private bool _isAnalyzing = false;
    private string? _analyzeError;
    private PlaceSuggestion? _suggestion;
    private List<string> _foundGpxUrls = [];
    private bool _isImportingGpx = false;
    private string? _importingGpxUrl;
    private string? _gpxImportError;
    private string? _routeEditorError;

    private readonly string _routeEditorId = $"route-editor-{Guid.NewGuid():N}";
    private readonly string _routeEditorMapId = $"route-editor-map-{Guid.NewGuid():N}";
    private bool _isRouteEditorOpen;
    private bool _routeEditorInitialized;
    private bool _isAddWaypointMode;
    private DotNetObjectReference<PlaceDialog>? _routeEditorDotNetRef;
    private List<GpxEditorPoint> _editorRoutePoints = [];
    private List<GpxEditorWaypoint> _editorWaypoints = [];

    private ApplicationUser? CurrentUser { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private ILogger<PlaceDialog> Logger { get; set; } = default!;



    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await UserService.GetCurrentUserAsync();
        SelectedTags = Content.Tags;
        await LoadGpxTracks();
        await LoadWishlists();

        if (CurrentUser is not null)
        {
            Tags = await PlaceRepository.GetAllTagsByUserAsync(CurrentUser.Id);

            // Only load image stubs for existing places that have images.
            // New places have an empty ImageIds list, so we skip the DB roundtrip.
            // Stubs are displayed via /api/placeImages/{id} to avoid loading full blobs on init.
            if (Content.ImageIds.Count > 0)
            {
                Content.Images = Content.ImageIds
                    .Select((id, idx) => new PlaceImage { Id = id, PlaceId = Content.Id, SortOrder = idx, ImageData = [] })
                    .ToList();
            }
        }
    }

    protected override void OnParametersSet()
    {
        _newPlaceCategoryString = Content?.Category.ToString() ?? string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isRouteEditorOpen && !_routeEditorInitialized)
        {
            await InitializeRouteEditorAsync();
        }
    }

    private async Task LoadGpxTracks()
    {
        if (CurrentUser is null) return;
        GpxTracks = await GpxRepository.GetAllByUserAsync(CurrentUser.Id);
    }

    private async Task LoadWishlists()
    {
        if (CurrentUser is null) return;

        Wishlists = await WishlistRepository.GetAllByUserAsync(CurrentUser.Id);
    }




    private void OnNewPlaceCategoryChanged(string value)
    {
        _newPlaceCategoryString = value;
        if (Content != null && Enum.TryParse<PlaceCategory>(value, out var category))
        {
            Content.Category = category;
        }
    }

    private async Task DownloadImageFromUrl()
    {
        _imageError = null;
        if (string.IsNullOrWhiteSpace(_imageUrl))
            return;

        if (!Uri.TryCreate(_imageUrl, UriKind.Absolute, out var uri) ||
            (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            _imageError = "Please enter a valid http or https URL.";
            return;
        }

        if (UrlSecurityHelper.IsPrivateOrLocalUri(uri))
        {
            _imageError = "Private or local URLs are not allowed.";
            return;
        }

        try
        {
            using var client = HttpClientFactory.CreateClient("UrlFetchNoRedirect");
            var response = await client.GetAsync(uri);

            // Manually follow up to 5 redirects, validating each Location against SSRF rules
            int redirects = 0;
            while (response.StatusCode is System.Net.HttpStatusCode.MovedPermanently
                                        or System.Net.HttpStatusCode.Found
                                        or System.Net.HttpStatusCode.SeeOther
                                        or System.Net.HttpStatusCode.TemporaryRedirect
                                        or System.Net.HttpStatusCode.PermanentRedirect)
            {
                if (++redirects > 5 || response.Headers.Location is not { } location)
                    break;

                var next = location.IsAbsoluteUri ? location : new Uri(uri, location);
                if ((next.Scheme != Uri.UriSchemeHttp && next.Scheme != Uri.UriSchemeHttps)
                    || UrlSecurityHelper.IsPrivateOrLocalUri(next))
                {
                    _imageError = "Private or local URLs are not allowed.";
                    return;
                }

                uri = next;
                response = await client.GetAsync(uri);
            }

            response.EnsureSuccessStatusCode();

            var contentType = response.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
            if (!contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                _imageError = "The URL does not point to an image.";
                return;
            }

            var data = await response.Content.ReadAsByteArrayAsync();
            if (data.Length > MaxImageSizeBytes)
            {
                _imageError = "Image exceeds the 5 MB size limit.";
                return;
            }

            AddImage(data, contentType);
            _imageUrl = string.Empty;
        }
        catch (Exception ex)
        {
            _imageError = $"Could not download image: {ex.Message}";
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _imageError = null;

        foreach (var file in e.GetMultipleFiles(MaxImageCount))
        {
            if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                _imageError = "Please select image files only.";
                continue;
            }

            if (file.Size > MaxImageSizeBytes)
            {
                _imageError = $"'{file.Name}' exceeds the 5 MB size limit.";
                continue;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: MaxImageSizeBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            AddImage(ms.ToArray(), file.ContentType);
        }
    }

    private void AddImage(byte[] data, string contentType)
    {
        var sortOrder = Content.Images.Any() ? Content.Images.Max(i => i.SortOrder) + 1 : 0;
        Content.Images.Add(new PlaceImage
        {
            PlaceId = Content.Id,
            ImageData = data,
            ImageContentType = contentType,
            SortOrder = sortOrder
        });
    }

    private void RemoveImage(PlaceImage img)
    {
        Content.Images.Remove(img);
    }

    private string GetImageSrc(PlaceImage img) =>
        img.ImageData.Length > 0
            ? $"data:{img.ImageContentType};base64,{Convert.ToBase64String(img.ImageData)}"
            : $"/api/placeImages/{img.Id}";

    private void OpenLightbox(int index)
    {
        _lightboxIndex = index;
    }

    private void OnLightboxIsOpenChanged(bool isOpen)
    {
        if (!isOpen) _lightboxIndex = -1;
    }

    private async Task SavePlace()
    {
        if (CurrentUser is null)
            return;

        if (Content == null || string.IsNullOrWhiteSpace(Content.Name))
            return;

        _urlError = null;
        _saveError = null;
        if (!string.IsNullOrWhiteSpace(Content.Url))
        {
            if (!Uri.TryCreate(Content.Url, UriKind.Absolute, out var uri) ||
                (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
            {
                _urlError = "Please enter a valid http or https URL.";
                return;
            }
        }

        if (string.IsNullOrEmpty(Content.WishlistId) && string.IsNullOrEmpty(Content.TripId))
        {
            if (!string.IsNullOrEmpty(SelectedWishlistId))
            {
                Content.WishlistId = SelectedWishlistId;
            }
            else
            {
                return;
            }
        }


        var placeExists = await PlaceRepository.ExistsAsync(Content.Id);

        Content.Tags = SelectedTags.ToList();

        if (!placeExists)
        {
            await PlaceRepository.AddAsync(Content);
        }
        else
        {
            // Verify the user still has access before updating. ExistsAsync confirmed the
            // place is in the DB; HasAccessAsync does a lightweight bool check without
            // loading the full entity (Content already contains all edited fields for UpdateAsync).
            var hasAccess = await PlaceRepository.HasAccessAsync(Content.Id, CurrentUser.Id);
            if (!hasAccess)
            {
                _saveError = "You no longer have access to this place and it cannot be saved.";
                return;
            }
            await PlaceRepository.UpdateAsync(Content);
