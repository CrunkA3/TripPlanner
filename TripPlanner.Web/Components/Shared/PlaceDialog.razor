    private Task OpenRouteEditor()
    {
        _routeEditorError = null;
        _isRouteEditorOpen = true;
        _routeEditorInitialized = false;
        _isAddWaypointMode = false;

        var existingTrack = !string.IsNullOrEmpty(Content.GpxTrackId)
            ? GpxTracks.FirstOrDefault(t => t.Id == Content.GpxTrackId)
            : null;

        _editorRoutePoints = existingTrack?.Points
            .OrderBy(p => p.Order)
            .Select(p => new GpxEditorPoint
            {
                Latitude = p.Latitude,
                Longitude = p.Longitude,
                Order = p.Order
            })
            .ToList() ?? [];

        _editorWaypoints = existingTrack?.Waypoints
            .OrderBy(w => w.Order)
            .Select(w => new GpxEditorWaypoint
            {
                Id = w.Id,
                Name = w.Name,
                Latitude = w.Latitude,
                Longitude = w.Longitude,
                Order = w.Order
            })
            .ToList() ?? [];

        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task InitializeRouteEditorAsync()
    {
        var centerLat = Content.Latitude != 0 ? Content.Latitude : 48.8566;
        var centerLng = Content.Longitude != 0 ? Content.Longitude : 2.3522;
        if (_editorRoutePoints.Count > 0)
        {
            centerLat = _editorRoutePoints[0].Latitude;
            centerLng = _editorRoutePoints[0].Longitude;
        }

        _routeEditorDotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("gpxRouteEditor.create", _routeEditorId, _routeEditorMapId, centerLat, centerLng, 11, _routeEditorDotNetRef, "OnRouteEditorChanged");
        await JS.InvokeVoidAsync("gpxRouteEditor.setData", _routeEditorId, _editorRoutePoints, _editorWaypoints);
        await JS.InvokeVoidAsync("gpxRouteEditor.setWaypointCreateMode", _routeEditorId, _isAddWaypointMode);
        _routeEditorInitialized = true;
    }

