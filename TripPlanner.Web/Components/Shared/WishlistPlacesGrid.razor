@using TripPlanner.Web.Models
@using TripPlanner.Web.Services
@using TripPlanner.Web.Repositories

@implements IDisposable

@inject UserService UserService

<FluentGrid Spacing="3" Justify="JustifyContent.FlexStart">
    @foreach (var place in Places)
    {
        <FluentGridItem xs="12" md="6" lg="3" xl="2" xxl="2">
            <div class="place-card" style="@("border-top-color: " + IPlaceRepository.GetCategoryColor(place.Category))">
                <div class="place-card-image-header">
                    @{
                        var imageCount = place.ImageIds?.Count ?? 0;
                        var currentIdx = imageCount > 0
                            ? Math.Clamp(_currentImageIndex.GetValueOrDefault(place.Id, 0), 0, imageCount - 1)
                            : 0;
                        var currentImg = imageCount > 0 ? place.ImageIds![currentIdx] : null;
                    }
                    @if (currentImg is not null)
                    {
                        <img @key="@currentImg"
                             src="@($"/api/placeImages/{currentImg}")"
                             srcset="@PlaceImageHelper.BuildSrcSet(currentImg)"
                             sizes="(max-width: 600px) calc(100vw - 32px), (max-width: 960px) calc(50vw - 24px), (max-width: 1280px) calc(25vw - 24px), calc(16.67vw - 24px)"
                             alt="@place.Name" />
                    }
                    else
                    {
                        <div class="place-card-placeholder @IPlaceRepository.GetCategoryClass(place.Category)">
                            <FluentIcon Value="@IPlaceRepository.GetCategoryIcon(place.Category)" Width="40px" Color="Color.Fill" />
                        </div>
                    }
                    @if (imageCount > 1)
                    {
                        <button type="button" class="carousel-btn carousel-prev" @onclick:stopPropagation="true" @onclick="@(() => NavigateImage(place, -1))" aria-label="Previous image">&#8249;</button>
                        <button type="button" class="carousel-btn carousel-next" @onclick:stopPropagation="true" @onclick="@(() => NavigateImage(place, 1))" aria-label="Next image">&#8250;</button>
                        <div class="carousel-dots">
                            @for (int i = 0; i < imageCount; i++)
                            {
                                var dotIdx = i;
                                <button type="button"
                                        class="carousel-dot @(dotIdx == currentIdx ? "carousel-dot-active" : "")"
                                        @onclick:stopPropagation="true"
                                        @onclick="@(() => SetImageIndex(place, dotIdx))"
                                        aria-label="@($"Show image {dotIdx + 1} of {imageCount}")"
                                        aria-current="@(dotIdx == currentIdx ? "true" : null)"></button>
                            }
                        </div>
                    }
                    @if (place.HasGpxTrack)
                    {
                        <span class="place-card-gpx-badge">
                            <FluentBadge Appearance="Appearance.Accent">
                                @if (place.GpxTrack != null)
                                {
                                    @($"{place.GpxTrack.TotalDistance:F1} km ↑{place.GpxTrack.ElevationGain:F0} m")
                                }
                                else
                                {
                                    @("GPX")
                                }
                            </FluentBadge>
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(place.Notes))
                    {
                        <span class="place-card-notes-badge">
                            <FluentBadge BackgroundColor="var(--neutral-layer-4)"><FluentIcon Value="@(new Icons.Regular.Size20.NoteEdit())" Width="12px" /> Notes</FluentBadge>
                        </span>
                    }
                    <div class="place-card-image-title">
                        <FluentLabel Typo="Typography.Subject" Weight="FontWeight.Bold" Class="place-card-title-label">@place.Name</FluentLabel>
                    </div>
                </div>

                <div class="place-card-body">
                    @if (!string.IsNullOrWhiteSpace(place.Description))
                    {
                        <FluentLabel Typo="Typography.Body" Class="place-card-description">@place.Description</FluentLabel>
                    }

                    @if (!string.IsNullOrWhiteSpace(place.Url))
                    {
                        <div class="place-card-location">
                            <FluentIcon Icon="Icons.Regular.Size12.Link" />
                            @if (IsSafeUrl(place.Url))
                            {
                                <a href="@place.Url" target="_blank" rel="noopener noreferrer" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@place.Url</a>
                            }
                            else
                            {
                                <span>@place.Url</span>
                            }
                        </div>
                    }

                    <div class="place-card-badges">
                        <FluentBadge BackgroundColor="@IPlaceRepository.GetCategoryColor(place.Category)" Color="white">@place.Category</FluentBadge>
                        @if (place.NeedsReview)
                        {
                            <FluentBadge BackgroundColor="var(--warning-fill-rest, #f0a500)" Color="white" title="This place was created automatically and needs review.">
                                ⚠️ Review
                                @if (CanUserEditPlace(place) && OnRemoveReview.HasDelegate)
                                {
                                    <FluentButton Appearance="Appearance.Lightweight" IconEnd="@(new Icons.Regular.Size12.Dismiss())" OnClick="@(() => OnRemoveReview.InvokeAsync(place.Id))" Style="min-width: 20px; min-height: 20px; padding: 2px; margin-left: 4px;" title="Mark as reviewed" aria-label="Mark as reviewed"></FluentButton>
                                }
                            </FluentBadge>
                        }
                        @if (place.Wishlist is not null)
                        {
                            <FluentBadge BackgroundColor="var(--neutral-layer-3)">@place.Wishlist.Name</FluentBadge>
                        }
                        @if (place.HasGpxTrack)
                        {
                            <a href="/api/gpx/@place.GpxTrackId" download title="GPX-Track herunterladen" class="place-card-gpx-download">
                                <FluentBadge BackgroundColor="var(--neutral-layer-3)"><FluentIcon Value="@(new Icons.Regular.Size16.ArrowDownload())" Width="12px" /> GPX</FluentBadge>
                            </a>
                        }
                    </div>

                    @if (place.Tags.Any())
                    {
                        <div class="place-card-tags">
                            @foreach (var tag in place.Tags)
                            {
                                <FluentBadge BackgroundColor="var(--accent-fill-rest)" Color="white">@tag</FluentBadge>
                            }
                        </div>
                    }

                    @if (place.VisitDate.HasValue)
                    {
                        <div class="place-card-location">
                            <FluentIcon Icon="Icons.Regular.Size12.Calendar" />
                            <span>
                                @place.VisitDate.Value.ToString("yyyy-MM-dd HH:mm")
                                @if (place.VisitDateEnd.HasValue)
                                {
                                    <text> – @place.VisitDateEnd.Value.ToString("yyyy-MM-dd HH:mm")</text>
                                }
                            </span>
                        </div>
                    }
                </div>

                @if (CanShowPlaceActions(place))
                {
                    <hr class="place-card-divider" />
                    <div class="place-card-footer">
                        @if (OnNotesPlace.HasDelegate)
                        {
                            <FluentButton Appearance="Appearance.Lightweight" IconStart="@(new Icons.Regular.Size20.NoteEdit())" OnClick="@(() => OnNotesPlace.InvokeAsync(place))">
                                Notes
                            </FluentButton>
                        }
                        @if (OnEditPlace.HasDelegate)
                        {
                            <FluentButton Appearance="Appearance.Lightweight" IconStart="@(new Icons.Regular.Size16.Edit())" OnClick="@(() => OnEditPlace.InvokeAsync(place))">
                                Edit
                            </FluentButton>
                        }
                        <FluentSpacer />
                        @if (OnDeletePlace.HasDelegate)
                        {
                            <FluentButton Appearance="Appearance.Lightweight" Color="var(--error)" IconStart="@(new Icons.Regular.Size16.Delete().WithColor(Color.Error))" OnClick="@(() => OnDeletePlace.InvokeAsync(place.Id))">
                                Delete
                            </FluentButton>
                        }
                    </div>
                }
            </div>
        </FluentGridItem>
    }
</FluentGrid>


@code {
    [Parameter, EditorRequired]
    public IEnumerable<Place> Places { get; set; } = default!;

    [Parameter, EditorRequired]
    public bool CanEdit { get; set; } = false;

    [Parameter]
    public EventCallback<Place> OnEditPlace { get; set; }

    [Parameter]
    public EventCallback<Place> OnNotesPlace { get; set; }

    [Parameter]
    public EventCallback<string> OnDeletePlace { get; set; }

    [Parameter]
    public EventCallback<string> OnRemoveReview { get; set; }

    private Dictionary<string, int> _currentImageIndex = new();
    private System.Timers.Timer? _carouselTimer;
    private int _carouselTickRunning = 0;

    private const int CarouselIntervalMs = 4000;

    private string? currentUserId;



    protected override async Task OnInitializedAsync()
    {
        currentUserId = await UserService.GetCurrentUserIdAsync();


    }

    protected override void OnParametersSet()
    {
        _currentImageIndex.Clear();

        var needsTimer = Places.Any(p => p.ImageIds.Count > 1);
        if (needsTimer && _carouselTimer == null)
        {
            _carouselTimer = new System.Timers.Timer(CarouselIntervalMs);
            _carouselTimer.Elapsed += OnCarouselTick;
            _carouselTimer.AutoReset = true;
            _carouselTimer.Start();
        }
        else if (!needsTimer && _carouselTimer != null)
        {
            _carouselTimer.Stop();
            _carouselTimer.Dispose();
            _carouselTimer = null;
        }
    }

    private async void OnCarouselTick(object? sender, System.Timers.ElapsedEventArgs e)
    {
        // Prevent overlapping ticks if a previous tick is still awaiting StateHasChanged
        if (Interlocked.CompareExchange(ref _carouselTickRunning, 1, 0) != 0)
            return;
        try
        {
            // Marshal index mutations and re-render onto the Blazor renderer thread to
            // avoid races with UI event handlers that also modify _currentImageIndex.
            await InvokeAsync(() =>
            {
                foreach (var place in Places.Where(p => p.ImageIds.Count > 1))
                {
                    _currentImageIndex[place.Id] = (_currentImageIndex.GetValueOrDefault(place.Id) + 1) % place.ImageIds.Count;
                }
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
        catch (TaskCanceledException) { }
        finally
        {
            Interlocked.Exchange(ref _carouselTickRunning, 0);
        }
    }

    private void NavigateImage(Place place, int delta)
    {
        var count = place.ImageIds.Count;
        if (count <= 1) return;
        var current = _currentImageIndex.GetValueOrDefault(place.Id, 0);
        _currentImageIndex[place.Id] = (current + delta + count) % count;
    }

    private void SetImageIndex(Place place, int index)
    {
        if (index >= 0 && index < place.ImageIds.Count)
            _currentImageIndex[place.Id] = index;
    }

    private static bool IsSafeUrl(string? url) =>
        !string.IsNullOrWhiteSpace(url) &&
        Uri.TryCreate(url, UriKind.Absolute, out var uri) &&
        (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps);

    private bool CanUserEditPlace(Place place) =>
        CanEdit &&
        place.Wishlist is not null &&
        place.Wishlist.SharedWith.Any(sw => sw.Level <= ShareLevel.Editor && sw.UserId == currentUserId);

    private bool CanShowPlaceActions(Place place) =>
        CanUserEditPlace(place) &&
        (OnEditPlace.HasDelegate || OnDeletePlace.HasDelegate || OnNotesPlace.HasDelegate || OnRemoveReview.HasDelegate);

    public void Dispose()
    {
        if (_carouselTimer != null)
        {
            _carouselTimer.Elapsed -= OnCarouselTick;
            _carouselTimer.Stop();
            _carouselTimer.Dispose();
            _carouselTimer = null;
        }
    }
}