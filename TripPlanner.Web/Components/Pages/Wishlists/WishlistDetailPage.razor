@page "/wishlists/{WishlistId}"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using TripPlanner.Web.Components.Shared
@using TripPlanner.Web.Models
@using TripPlanner.Web.Repositories
@using TripPlanner.Web.Services

@attribute [Authorize]
@implements IDisposable

@inject IWishlistRepository WishlistRepository
@inject IPlaceRepository PlaceRepository
@inject BrowserTimeZoneService BrowserTimeZoneService
@inject UserService UserService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject ISemanticSearchService SemanticSearchService
@inject WishlistImportExportService ImportExportService
@inject IJSRuntime JS

<PageTitle>@(wishlist?.Name ?? "Wishlist")</PageTitle>
<FluentDialogProvider />

@if (wishlist == null)
{
    <FluentProgressRing>Loading wishlist...</FluentProgressRing>
}
else if (!canAccess)
{
    <FluentMessageBar Intent="MessageIntent.Error">
        You do not have permission to view this wishlist.
    </FluentMessageBar>
}
else
{
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" Width="100%">
        <FluentToolbar>
            <FluentButton Appearance="Appearance.Lightweight" IconStart="@(new Icons.Regular.Size20.ArrowLeft())" OnClick="@(() => NavigationManager.NavigateTo("/wishlists"))">
                Back to Wishlists
            </FluentButton>
            <FluentSpacer />
            <FluentLabel Typo="Typography.H3">
                <FluentIcon Icon="Icons.Regular.Size24.Heart" Color="Color.Accent" />
                @wishlist.Name
            </FluentLabel>
            <FluentSpacer />
            <FluentButton Appearance="Appearance.Lightweight"
                          IconStart="@(new Icons.Regular.Size20.ArrowDownload())"
                          OnClick="@ExportYaml"
                          title="Export wishlist as YAML"
                          data-testid="export-wishlist-button">
                Export
            </FluentButton>
            @if (canEdit)
            {
                <FluentButton Appearance="Appearance.Lightweight"
                              IconStart="@(new Icons.Regular.Size20.ArrowUpload())"
                              OnClick="@TriggerImportInput"
                              title="Import places from YAML file"
                              data-testid="import-wishlist-button">
                    Import
                </FluentButton>
                <InputFile id="@_importFileInputId"
                           OnChange="@HandleImportFileSelected"
                           accept=".yaml,.yml"
                           style="display:none;" />
            }
            @if (canEdit)
            {
                <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="@ShowAddPlaceDialog" data-testid="add-place-button">
                    Add Place
                </FluentButton>
            }
        </FluentToolbar>

        @if (!string.IsNullOrEmpty(_importExportMessage))
        {
            <FluentMessageBar Intent="@_importExportMessageIntent" OnDismiss="@(() => _importExportMessage = null)" Style="margin-top: 4px;">
                @_importExportMessage
            </FluentMessageBar>
        }

        @if (!string.IsNullOrEmpty(wishlist.Description))
        {
            <FluentCard>
                <FluentLabel>@wishlist.Description</FluentLabel>
            </FluentCard>
        }

        @if (places != null && places.Count > 0)
        {
            <FluentCard AreaRestricted="false">
                <FluentStack Orientation="Orientation.Horizontal" Width="100%" Wrap="true">
                    <FluentSearch @bind-Value="@SearchText"
                                  Placeholder="Search by name, description or tags…"
                                  Label="Search"
                                  Style="min-width: 220px;"
                                  Immediate="true"
                                  ImmediateDelay="200" />
                    <FluentButton Appearance="Appearance.Accent"
                                  IconStart="@(new Icons.Regular.Size20.Bot())"
                                  OnClick="@RunSemanticSearchAsync"
                                  Disabled="@(string.IsNullOrWhiteSpace(SearchText) || IsSemanticSearching)"
                                  AriaLabel="AI Search"
                                  title="Search with AI (semantic search)">
                        @if (IsSemanticSearching)
                        {
                            <FluentProgressRing Width="16px" />
                        }
                        else
                        {
                            <span>AI Search</span>
                        }
                    </FluentButton>
                    <FluentAutocomplete TOption="string"
                                        Label="Filter by Tags"
                                        Placeholder="Filter by tags…"
                                        OnOptionsSearch="@OnTagFilterSearchAsync"
                                        @bind-SelectedOptions="@FilterTags"
                                        Style="min-width: 200px;" />
                    <FluentButton Appearance="Appearance.Lightweight" IconStart="@(new Icons.Regular.Size20.Eraser())" OnClick="@ClearFilters">
                        Clear
                    </FluentButton>
                </FluentStack>
                @if (SemanticSearchActive)
                {
                    <FluentMessageBar Intent="MessageIntent.Info" Style="margin-top: 8px;">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Bot())" Style="margin-right: 4px;" />
                        Showing AI-ranked results for &ldquo;@LastSemanticQuery&rdquo;. <FluentButton Appearance="Appearance.Lightweight" OnClick="@ClearSemanticSearch" Class="semantic-search-clear-btn">Return to normal search</FluentButton>
                    </FluentMessageBar>
                }
            </FluentCard>
        }

        <WishlistImportJobs CanEdit="@canEdit" WishlistId="@WishlistId" />

        @if (places == null)
        {
            <FluentProgressRing>Loading places...</FluentProgressRing>
        }
        else if (!FilteredPlaces.Any())
        {
            <FluentCard>
                <p>@EmptyPlacesMessage</p>
            </FluentCard>
        }
        else
        {
            <WishlistPlacesGrid Places="FilteredPlaces" CanEdit="canEdit" OnEditPlace="EditPlace" OnDeletePlace="DeletePlace" OnNotesPlace="OpenNotes" OnRemoveReview="RemoveReview" />
        }
    </FluentStack>
}


@code {
    [Parameter]
    public string WishlistId { get; set; } = string.Empty;

    private Wishlist? wishlist;
    private List<Place>? places;
    private List<UrlImportJob>? importJobs;
    private bool canAccess;
    private bool canEdit;
    private string? currentUserId;

    private string _importFileInputId = $"import-yaml-{Guid.NewGuid():N}";
    private string? _importExportMessage;
    private MessageIntent _importExportMessageIntent = MessageIntent.Info;

    private string SearchText { get; set; } = string.Empty;
    private IEnumerable<string> FilterTags { get; set; } = Array.Empty<string>();

    private bool IsSemanticSearching { get; set; } = false;
    private bool SemanticSearchActive { get; set; } = false;
    private IReadOnlyList<Place>? SemanticSearchResults { get; set; }
    private string LastSemanticQuery { get; set; } = string.Empty;
    private CancellationTokenSource? _semanticSearchCts;

    private IEnumerable<Place> FilteredPlaces =>
        (SemanticSearchActive && SemanticSearchResults != null
            ? SemanticSearchResults.AsEnumerable()
            : places?
                .Where(p => string.IsNullOrWhiteSpace(SearchText) ||
                    p.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    (p.Description?.Contains(SearchText, StringComparison.OrdinalIgnoreCase) == true) ||
                    (p.Tags != null && p.Tags.Any(t => t.Contains(SearchText, StringComparison.OrdinalIgnoreCase))))
                .AsEnumerable()
            ?? Enumerable.Empty<Place>())
        .Where(p => !FilterTags.Any() || FilterTags.All(t => (p.Tags ?? Enumerable.Empty<string>()).Contains(t)));

    private string EmptyPlacesMessage =>
        places?.Count == 0
            ? "This wishlist doesn't have any places yet. Click \"Add Place\" to start adding places."
            : "No places match the current filter.";

    private Task OnTagFilterSearchAsync(OptionsSearchEventArgs<string> e)
    {
        var allTags = places?
            .SelectMany(p => p.Tags)
            .Distinct()
            .OrderBy(t => t)
            .ToList() ?? new List<string>();

        e.Items = string.IsNullOrWhiteSpace(e.Text)
            ? allTags.Where(t => !FilterTags.Contains(t))
            : allTags.Where(t => t.Contains(e.Text, StringComparison.OrdinalIgnoreCase) && !FilterTags.Contains(t));

        return Task.CompletedTask;
    }

    private void ClearFilters()
    {
        SearchText = string.Empty;
        FilterTags = Array.Empty<string>();
        ClearSemanticSearch();
    }

    private void ClearSemanticSearch()
    {
        _semanticSearchCts?.Cancel();
        SemanticSearchActive = false;
        SemanticSearchResults = null;
        LastSemanticQuery = string.Empty;
    }

    private async Task RunSemanticSearchAsync()
    {
        if (places is null || string.IsNullOrWhiteSpace(SearchText)) return;

        _semanticSearchCts?.Cancel();
        _semanticSearchCts?.Dispose();
        _semanticSearchCts = new CancellationTokenSource();
        var cts = _semanticSearchCts;

        IsSemanticSearching = true;
        StateHasChanged();
        try
        {
            LastSemanticQuery = SearchText;
            SemanticSearchResults = await SemanticSearchService.SearchAsync(SearchText, places, cts.Token);
            if (!cts.Token.IsCancellationRequested)
                SemanticSearchActive = true;
        }
        catch (OperationCanceledException)
        {
            // Search was superseded by a newer request or component disposal; discard results.
        }
        finally
        {
            IsSemanticSearching = false;
        }
    }

    public void Dispose()
    {
        _semanticSearchCts?.Cancel();
        _semanticSearchCts?.Dispose();
    }



    protected override async Task OnInitializedAsync()
    {
        currentUserId = await UserService.GetCurrentUserIdAsync();
        if (currentUserId != null)
        {
            await LoadWishlist();
        }
    }

    private async Task LoadWishlist()
    {
        if (currentUserId == null) return;

        wishlist = await WishlistRepository.GetByIdAsync(WishlistId);
        if (wishlist != null)
        {
            canAccess = await WishlistRepository.CanUserAccessAsync(WishlistId, currentUserId);
            if (canAccess)
            {
                canEdit = await WishlistRepository.CanUserEditAsync(WishlistId, currentUserId);
                await LoadPlaces();
            }
        }
    }

    private async Task LoadPlaces()
    {
        if (currentUserId == null) return;
        places = await PlaceRepository.GetByWishlistIdAsync(WishlistId, currentUserId);
    }




    private async Task ShowAddPlaceDialog()
    {
        var dialog = await DialogService.ShowDialogAsync<PlaceDialog>(new Place() { WishlistId = WishlistId }, new DialogParameters()
        {
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            TrapFocus = true
        });

        var result = await dialog.Result;

        if (!result.Cancelled && result.Data is not null)
        {
            
            await LoadPlaces();
            StateHasChanged();
        }
    }

    private async Task EditPlace(Place place)
    {
        var dialog = await DialogService.ShowDialogAsync<PlaceDialog>(place, new DialogParameters()
        {
            Title = "Edit Place",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            TrapFocus = true
        });

        var result = await dialog.Result;

        if (!result.Cancelled && result.Data is not null)
        {
            StateHasChanged();
        }
    }

    private async Task OpenNotes(Place place)
    {
        var panel = await DialogService.ShowPanelAsync<PlaceNotesDrawer>(place, new DialogParameters()
        {
            Title = $"Notes: {place.Name}",
            Width = "min(95vw, 1000px)",
            PreventDismissOnOverlayClick = false,
        });

        await panel.Result;
    }

    private async Task DeletePlace(string placeId)
    {
        if (currentUserId is null) return;

        var place = places?.FirstOrDefault(p => p.Id == placeId);
        var name = place?.Name ?? "this place";
        var dialog = await DialogService.ShowDialogAsync<ConfirmDialog>(
            new ConfirmDialogContent($"Are you sure you want to delete \"{name}\"?"),
            new DialogParameters { Title = "Confirm Delete", PreventDismissOnOverlayClick = true });
        var result = await dialog.Result;
        if (result.Cancelled) return;

        await PlaceRepository.DeleteAsync(placeId, currentUserId);
        await LoadPlaces();
    }

    private async Task RemoveReview(string placeId)
    {
        if (currentUserId is null || !canEdit) return;

        await PlaceRepository.MarkAsReviewedAsync(placeId, currentUserId);
        await LoadPlaces();
    }

    private async Task ExportYaml()
    {
        if (currentUserId is null || wishlist is null) return;

        _importExportMessage = null;
        try
        {
            var yaml = await ImportExportService.ExportToYamlAsync(WishlistId, currentUserId);
            var safeName = string.Concat(wishlist.Name.Split(System.IO.Path.GetInvalidFileNameChars()));
            var filename = $"{safeName}-export.yaml";
            await JS.InvokeVoidAsync("downloadTextFile", filename, "application/x-yaml", yaml);
        }
        catch (Exception ex)
        {
            _importExportMessage = $"Export failed: {ex.Message}";
            _importExportMessageIntent = MessageIntent.Error;
        }
    }

    private async Task TriggerImportInput()
    {
        await JS.InvokeVoidAsync("clickElementById", _importFileInputId);
    }

    private async Task HandleImportFileSelected(InputFileChangeEventArgs e)
    {
        if (currentUserId is null) return;

        _importExportMessage = null;
        var file = e.File;

        // Max 150 MB for YAML files
        const long maxSize = 150 * 1024 * 1024;
        if (file.Size > maxSize)
        {
            _importExportMessage = "File is too large. Maximum size is 150 MB.";
            _importExportMessageIntent = MessageIntent.Error;
            return;
        }

        try
        {
            using var reader = new System.IO.StreamReader(file.OpenReadStream(maxAllowedSize: maxSize));
            var yaml = await reader.ReadToEndAsync();
            var count = await ImportExportService.ImportFromYamlAsync(yaml, WishlistId, currentUserId);
            _importExportMessage = $"Successfully imported {count} place(s).";
            _importExportMessageIntent = MessageIntent.Success;
            await LoadPlaces();
        }
        catch (FormatException fex)
        {
            _importExportMessage = $"Import failed: {fex.Message}";
            _importExportMessageIntent = MessageIntent.Error;
        }
        catch (Exception ex)
        {
            _importExportMessage = $"Import failed: {ex.Message}";
            _importExportMessageIntent = MessageIntent.Error;
        }
    }
}
