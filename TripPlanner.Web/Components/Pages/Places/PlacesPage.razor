@page "/places"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using TripPlanner.Web.Models
@using TripPlanner.Web.Repositories
@using TripPlanner.Web.Services
@using TripPlanner.Web.Components.Shared
@using TripPlanner.Web.Components.Pages.Collections
@using static TripPlanner.Web.Components.Shared.GpxFileUpload

@attribute [Authorize]
@implements IDisposable

@inject IWishlistRepository WishlistRepository
@inject IPlaceRepository PlaceRepository
@inject IGpxRepository GpxRepository
@inject GpxService GpxService
@inject UserService UserService
@inject IDialogService DialogService
@inject ISemanticSearchService SemanticSearchService

<PageTitle>Wishlist</PageTitle>
<FluentDialogProvider />

<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Stretch" Width="100%">
    <FluentToolbar>
        <FluentLabel Typo="Typography.H3">
            <FluentIcon Icon="Icons.Regular.Size24.Heart" Color="Color.Accent" />
            Place Wishlist
        </FluentLabel>
        <FluentSpacer />
        <FluentButton Appearance="Appearance.Accent" OnClick="@CreateNewPlace" IconStart="@(new Icons.Regular.Size20.Add())" data-testid="add-place-button">
            Add Place
        </FluentButton>
    </FluentToolbar>

    <FluentCard AreaRestricted="false">
        <FluentStack Orientation="Orientation.Horizontal" Width="100%" Wrap="true">
            <FluentSearch @bind-Value="@SearchText"
                          Placeholder="Search by name, description or tags…"
                          Label="Search"
                          Style="min-width: 220px;"
                          Immediate="true"
                          ImmediateDelay="200" />
            <FluentButton Appearance="Appearance.Accent"
                          IconStart="@(new Icons.Regular.Size20.Bot())"
                          OnClick="@RunSemanticSearchAsync"
                          Disabled="@(string.IsNullOrWhiteSpace(SearchText) || IsSemanticSearching)"
                          AriaLabel="AI Search"
                          title="Search with AI (semantic search)">
                @if (IsSemanticSearching)
                {
                    <FluentProgressRing Width="16px" />
                }
                else
                {
                    <span>AI Search</span>
                }
            </FluentButton>

            <FluentSelect TOption="string" @bind-Value="@FilterCategoryString" Label="Category" Style="min-width: 200px;">
                <FluentOption TOption="string" Value="">All Categories</FluentOption>
                @foreach (var category in Enum.GetValues<PlaceCategory>())
                {
                    <FluentOption TOption="string" Value="@category.ToString()">@category.ToString()</FluentOption>
                }
            </FluentSelect>
            
            <FluentCheckbox @bind-Value="@FilterHasGpxValue" Label="Has GPX Track" />
            
            <FluentDatePicker Label="Visit Date From" @bind-Value="@FilterDateFrom" Style="min-width: 180px;" />
            <FluentDatePicker Label="Visit Date To" @bind-Value="@FilterDateTo" Style="min-width: 180px;" />
            
            <FluentAutocomplete TOption="string"
                                Label="Tags"
                                Placeholder="Filter by tags…"
                                OnOptionsSearch="@OnTagFilterSearchAsync"
                                @bind-SelectedOptions="@FilterTags"
                                Style="min-width: 200px;" />
            
            <FluentButton Appearance="Appearance.Lightweight" IconStart="@(new Icons.Regular.Size20.Filter())" OnClick="@ApplyFilters">
                Apply Filters
            </FluentButton>
            
            <FluentButton Appearance="Appearance.Lightweight" IconStart="@(new Icons.Regular.Size20.Eraser())" OnClick="@ClearFilters">
                Clear
            </FluentButton>
        </FluentStack>
        @if (SemanticSearchActive)
        {
            <FluentMessageBar Intent="MessageIntent.Info" Style="margin-top: 8px;">
                <FluentIcon Value="@(new Icons.Regular.Size16.Bot())" Style="margin-right: 4px;" />
                Showing AI-ranked results for &ldquo;@LastSemanticQuery&rdquo;. <FluentButton Appearance="Appearance.Lightweight" OnClick="@ClearSemanticSearch" Class="semantic-search-clear-btn">Return to normal search</FluentButton>
            </FluentMessageBar>
        }
    </FluentCard>

    @if (IsLoading)
    {
        <FluentProgressRing />
    }
    else if (DisplayedPlaces is null || !DisplayedPlaces.Any())
    {
        <FluentCard>
            <FluentStack HorizontalAlignment="HorizontalAlignment.Center" VerticalAlignment="VerticalAlignment.Center">
                <FluentIcon Icon="Icons.Regular.Size48.LocationOff" Color="Color.Neutral" />
                <FluentLabel Typo="Typography.Body">No places in your wishlist yet. Add your first place!</FluentLabel>
            </FluentStack>
        </FluentCard>
    }
    else
    {
        <WishlistPlacesGrid CanEdit="true" Places="DisplayedPlaces" OnEditPlace="EditPlace" OnDeletePlace="DeletePlace" OnNotesPlace="OpenNotes" OnRemoveReview="RemoveReview" OnAddToCollection="ShowAddToCollectionDialog" />
    }
</FluentStack>

<FluentDialog @bind-Hidden="@HideAddDialog" Modal="true" TrapFocus="true">
    <FluentDialogHeader>
        <FluentLabel Typo="Typography.H4">@(EditingPlace?.Id != null ? "Edit Place" : "Add New Place")</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        @if (EditingPlace != null)
        {
            <FluentStack Orientation="Orientation.Vertical">
                @if (string.IsNullOrEmpty(EditingPlace.WishlistId) && string.IsNullOrEmpty(EditingPlace.TripId))
                {
                    <FluentSelect TOption="Wishlist"
                                  @bind-SelectdOption="SelectedWishlist"
                                  Label="Wishlist"
                                  Items="Wishlists"
                                  OptionValue="@(wl => wl.Id)"
                                  OptionText="@(wl => wl.Name)"
                                  Required />
                }
                <FluentTextField @bind-Value="@EditingPlace.Name" Label="Name" Required Style="width: 100%;" />
                <FluentTextArea @bind-Value="@EditingPlace.Description" Label="Description" Rows="3" Style="width: 100%;" />
                
                <FluentSelect TOption="string" Value="@_selectedCategoryString" Label="Category" Style="width: 100%;" ValueChanged="@OnCategoryChanged">
                    @foreach (var category in Enum.GetValues<PlaceCategory>())
                    {
                        <FluentOption TOption="string" Value="@category.ToString()">@category.ToString()</FluentOption>
                    }
                </FluentSelect>
                
                <FluentTextField @bind-Value="@EditingPlace.LatitudeString" Label="Latitude" Style="width: 100%;" />
                <FluentTextField @bind-Value="@EditingPlace.LongitudeString" Label="Longitude" Style="width: 100%;" />

                <FluentStack Orientation="Orientation.Horizontal" Width="100%" Style="gap: 8px;">
                    <FluentDatePicker Label="Visit Date" Value="@EditingPlace.VisitDate?.DateTime" ValueChanged="@(d => EditingPlace.VisitDate = d.HasValue ? (DateTimeOffset?)(d.Value.Date + (EditingPlace.VisitDate?.TimeOfDay ?? TimeSpan.Zero)) : null)" Style="flex: 1;" />
                    <FluentTimePicker Label="Visit Time" Value="@EditingPlace.VisitDate?.DateTime" ValueChanged="@(t => EditingPlace.VisitDate = t.HasValue ? (DateTimeOffset?)((EditingPlace.VisitDate?.Date ?? DateTime.Today) + t.Value.TimeOfDay) : null)" Style="flex: 1;" />
                </FluentStack>
                <FluentStack Orientation="Orientation.Horizontal" Width="100%" Style="gap: 8px;">
                    <FluentDatePicker Label="Visit Date End" Value="@EditingPlace.VisitDateEnd?.DateTime" ValueChanged="@(d => EditingPlace.VisitDateEnd = d.HasValue ? (DateTimeOffset?)(d.Value.Date + (EditingPlace.VisitDateEnd?.TimeOfDay ?? TimeSpan.Zero)) : null)" Style="flex: 1;" />
                    <FluentTimePicker Label="Visit Time End" Value="@EditingPlace.VisitDateEnd?.DateTime" ValueChanged="@(t => EditingPlace.VisitDateEnd = t.HasValue ? (DateTimeOffset?)((EditingPlace.VisitDateEnd?.Date ?? DateTime.Today) + t.Value.TimeOfDay) : null)" Style="flex: 1;" />
                </FluentStack>
                @if (EditingPlace.VisitDate.HasValue && EditingPlace.VisitDateEnd.HasValue && EditingPlace.VisitDateEnd < EditingPlace.VisitDate)
                {
                    <FluentLabel Color="Color.Error" Style="font-size: 0.875em;">Visit end date must be on or after the start date.</FluentLabel>
                }

                
                <FluentTextField @bind-Value="@NewTag" Label="Add Tags" Placeholder="Type and press Enter"
                                 @onkeydown="@HandleTagKeyDown" Style="width: 100%;" />
                
                <FluentStack Orientation="Orientation.Horizontal" Wrap="true">
                    @foreach (var tag in EditingPlace.Tags)
                    {
                        <FluentBadge BackgroundColor="var(--accent-fill-rest)">
                            @tag
                            <FluentButton Appearance="Appearance.Lightweight" IconEnd="@(new Icons.Regular.Size12.Dismiss())" OnClick="@(() => RemoveTag(tag))" Style="padding: 0; margin-left: 4px;"></FluentButton>
                        </FluentBadge>
                    }
                </FluentStack>

                <FluentDivider />
                
                <FluentLabel Typo="Typography.Subject">GPX Track (Optional)</FluentLabel>
                @if (!string.IsNullOrEmpty(EditingPlace.GpxTrackId))
                {
                    var gpxTrack = GpxTracks.FirstOrDefault(g => g.Id == EditingPlace.GpxTrackId);
                    @if (gpxTrack != null)
                    {
                        <FluentCard>
                            <FluentStack Orientation="Orientation.Horizontal">
                                <FluentIcon Icon="Icons.Regular.Size20.Location" Color="Color.Accent" />
                                <FluentStack Orientation="Orientation.Vertical" Style="flex: 1;">
                                    <FluentLabel Weight="FontWeight.Bold">@gpxTrack.Name</FluentLabel>
                                    <FluentLabel Style="font-size: 0.875em;">
                                        Distance: @gpxTrack.TotalDistance.ToString("F2") km | Points: @gpxTrack.Points.Count
                                    </FluentLabel>
                                </FluentStack>
                                <FluentButton Appearance="Appearance.Lightweight" IconStart="@(new Icons.Regular.Size16.Delete())" OnClick="@RemoveGpxTrack">
                                </FluentButton>
                            </FluentStack>
                        </FluentCard>
                    }
                }
                else
                {
                    <GpxFileUpload OnFileUploaded="@HandleGpxUploaded" />
                }
            </FluentStack>
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" OnClick="@SavePlace">Save</FluentButton>
        <FluentButton Appearance="Appearance.Neutral" OnClick="@(() => HideAddDialog = true)">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>


@code {
    private List<Wishlist>? Wishlists { get; set; }
    private Wishlist? SelectedWishlist { get; set; }

    private IQueryable<Place>? Places { get; set; }
    private IQueryable<Place>? FilteredPlaces => Places?
        .Where(p => string.IsNullOrWhiteSpace(SearchText) ||
            p.Name.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
            (p.Description != null && p.Description.Contains(SearchText, StringComparison.OrdinalIgnoreCase)) ||
            (p.Tags != null && p.Tags.Any(t => t.Contains(SearchText, StringComparison.OrdinalIgnoreCase))))
        .Where(p => !FilterCategory.HasValue || p.Category == FilterCategory.Value)
        .Where(p => !FilterHasGpx.GetValueOrDefault(false) || p.GpxTrackId != null)
        .Where(p => FilterDateFrom == null || (p.VisitDate.HasValue && p.VisitDate.Value.DateTime >= FilterDateFrom.Value))
        .Where(p => FilterDateTo == null || (p.VisitDate.HasValue && p.VisitDate.Value.DateTime <= FilterDateTo.Value))
        .Where(p => !FilterTags.Any() || FilterTags.All(t => (p.Tags ?? Enumerable.Empty<string>()).Contains(t)));

    // When semantic search is active, show its ranked results (still subject to non-text filters);
    // otherwise fall through to the normal text-filtered list.
    private IEnumerable<Place>? DisplayedPlaces =>
        SemanticSearchActive && SemanticSearchResults != null
            ? SemanticSearchResults
                .Where(p => !FilterCategory.HasValue || p.Category == FilterCategory.Value)
                .Where(p => !FilterHasGpx.GetValueOrDefault(false) || p.GpxTrackId != null)
                .Where(p => FilterDateFrom == null || (p.VisitDate.HasValue && p.VisitDate.Value.DateTime >= FilterDateFrom.Value))
                .Where(p => FilterDateTo == null || (p.VisitDate.HasValue && p.VisitDate.Value.DateTime <= FilterDateTo.Value))
                .Where(p => !FilterTags.Any() || FilterTags.All(t => (p.Tags ?? Enumerable.Empty<string>()).Contains(t)))
            : FilteredPlaces?.AsEnumerable();

    private List<GpxTrack> GpxTracks { get; set; } = new();
    private bool IsLoading { get; set; } = true;
    private bool HideAddDialog { get; set; } = true;
    private Place? EditingPlace { get; set; }
    private string SearchText { get; set; } = string.Empty;
    private bool IsSemanticSearching { get; set; } = false;
    private bool SemanticSearchActive { get; set; } = false;
    private IReadOnlyList<Place>? SemanticSearchResults { get; set; }
    private string LastSemanticQuery { get; set; } = string.Empty;
    private CancellationTokenSource? _semanticSearchCts;
    private PlaceCategory? FilterCategory { get; set; }
    private string FilterCategoryString { get; set; } = string.Empty;
    private bool? FilterHasGpx { get; set; }
    private bool FilterHasGpxValue { get; set; }
    private DateTime? FilterDateFrom { get; set; }
    private DateTime? FilterDateTo { get; set; }
    private IEnumerable<string> FilterTags { get; set; } = Array.Empty<string>();
    private string NewTag { get; set; } = string.Empty;
    private string _selectedCategoryString = string.Empty;

    private ApplicationUser? CurrentUser { get; set; }

    private void OnCategoryChanged(string value)
    {
        _selectedCategoryString = value;
        if (EditingPlace != null && Enum.TryParse<PlaceCategory>(value, out var category))
        {
            EditingPlace.Category = category;
        }
    }

    private Task OnTagFilterSearchAsync(OptionsSearchEventArgs<string> e)
    {
        var allTags = Places?
            .SelectMany(p => p.Tags)
            .Distinct()
            .OrderBy(t => t)
            .ToList() ?? new List<string>();

        e.Items = string.IsNullOrWhiteSpace(e.Text)
            ? allTags.Where(t => !FilterTags.Contains(t))
            : allTags.Where(t => t.Contains(e.Text, StringComparison.OrdinalIgnoreCase) && !FilterTags.Contains(t));

        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await UserService.GetCurrentUserAsync();

        await LoadPlaces();
        await LoadGpxTracks();
    }

    private async Task LoadPlaces()
    {
        if (CurrentUser is null) return;

        IsLoading = true;
        Places = (await PlaceRepository.GetAllWithAnyWishlistAsync(CurrentUser.Id)).AsQueryable();
        IsLoading = false;
    }

    private async Task LoadGpxTracks()
    {
        if (CurrentUser is null) return;
        GpxTracks = await GpxRepository.GetAllByUserAsync(CurrentUser.Id);
    }

    private async Task LoadWishlists()
    {
        if (CurrentUser is null) return;

        Wishlists = await WishlistRepository.GetAllByUserAsync(CurrentUser.Id);
    }

    private async Task ApplyFilters()
    {
        IsLoading = true;
        FilterCategory = string.IsNullOrEmpty(FilterCategoryString) ? null : Enum.Parse<PlaceCategory>(FilterCategoryString);
        FilterHasGpx = FilterHasGpxValue ? true : (bool?)null;
        IsLoading = false;
    }

    private async Task ClearFilters()
    {
        SearchText = string.Empty;
        FilterCategory = null;
        FilterCategoryString = string.Empty;
        FilterHasGpx = null;
        FilterHasGpxValue = false;
        FilterDateFrom = null;
        FilterDateTo = null;
        FilterTags = Array.Empty<string>();
        ClearSemanticSearch();
        await LoadPlaces();
    }

    private void ClearSemanticSearch()
    {
        _semanticSearchCts?.Cancel();
        SemanticSearchActive = false;
        SemanticSearchResults = null;
        LastSemanticQuery = string.Empty;
    }

    private async Task RunSemanticSearchAsync()
    {
        if (Places is null || string.IsNullOrWhiteSpace(SearchText)) return;

        _semanticSearchCts?.Cancel();
        _semanticSearchCts?.Dispose();
        _semanticSearchCts = new CancellationTokenSource();
        var cts = _semanticSearchCts;

        IsSemanticSearching = true;
        StateHasChanged();
        try
        {
            LastSemanticQuery = SearchText;
            SemanticSearchResults = await SemanticSearchService.SearchAsync(SearchText, Places, cts.Token);
            if (!cts.Token.IsCancellationRequested)
                SemanticSearchActive = true;
        }
        catch (OperationCanceledException)
        {
            // Search was superseded by a newer request or component disposal; discard results.
        }
        finally
        {
            IsSemanticSearching = false;
        }
    }

    public void Dispose()
    {
        _semanticSearchCts?.Cancel();
        _semanticSearchCts?.Dispose();
    }

    private async Task CreateNewPlace()
    {
        var dialog = await DialogService.ShowDialogAsync<PlaceDialog>(new Place(), new DialogParameters()
        {
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            TrapFocus = true
        });

        var result = await dialog.Result;

        if (!result.Cancelled && result.Data is not null)
        {
            
            await LoadPlaces();
            StateHasChanged();
        }
    }

    private async Task EditPlace(Place place)
    {
        var dialog = await DialogService.ShowDialogAsync<PlaceDialog>(place, new DialogParameters()
        {
            Title = "Edit Place",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
            TrapFocus = true
        });

        var result = await dialog.Result;

        if (!result.Cancelled && result.Data is not null)
        {
            StateHasChanged();
        }
    }

    private async Task OpenNotes(Place place)
    {
        var panel = await DialogService.ShowPanelAsync<PlaceNotesDrawer>(place, new DialogParameters()
        {
            Title = $"Notes: {place.Name}",
            Width = "min(95vw, 1000px)",
            PreventDismissOnOverlayClick = false,
        });

        await panel.Result;
    }

    private async Task DeletePlace(string placeId)
    {
        if (CurrentUser is null) return;

        var place = Places?.FirstOrDefault(p => p.Id == placeId);
        var name = place?.Name ?? "this place";
        var dialog = await DialogService.ShowDialogAsync<ConfirmDialog>(
            new ConfirmDialogContent($"Are you sure you want to delete \"{name}\"?"),
            new DialogParameters { Title = "Confirm Delete", PreventDismissOnOverlayClick = true });
        var result = await dialog.Result;
        if (result.Cancelled) return;

        await PlaceRepository.DeleteAsync(placeId, CurrentUser.Id);
        await LoadPlaces();
    }

    private async Task RemoveReview(string placeId)
    {
        if (CurrentUser is null) return;

        await PlaceRepository.MarkAsReviewedAsync(placeId, CurrentUser.Id);
        await LoadPlaces();
    }

    private async Task ShowAddToCollectionDialog(Place place)
    {
        await DialogService.ShowDialogAsync<AddToCollectionDialog>(
            new AddToCollectionDialogContent(place.Id, place.Name),
            new DialogParameters { Modal = true, PreventDismissOnOverlayClick = true });
    }

    private async Task SavePlace()
    {
        if (EditingPlace == null) return;
        if (string.IsNullOrEmpty(EditingPlace.WishlistId) && string.IsNullOrEmpty(EditingPlace.TripId))
        {
            if (SelectedWishlist != null)
            {
                EditingPlace.WishlistId = SelectedWishlist.Id;
            }
            else
            {
                return;
            }
        }

        if (string.IsNullOrEmpty(EditingPlace.Id) || (Places is not null && !Places.Any(p => p.Id == EditingPlace.Id)))
        {
            await PlaceRepository.AddAsync(EditingPlace);
        }
        else
        {
            await PlaceRepository.UpdateAsync(EditingPlace);
        }

        HideAddDialog = true;
        EditingPlace = null;
        await LoadPlaces();
    }

    private void HandleTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(NewTag))
        {
            if (EditingPlace != null && !EditingPlace.Tags.Contains(NewTag))
            {
                EditingPlace.Tags.Add(NewTag);
                NewTag = string.Empty;
            }
        }
    }

    private void RemoveTag(string tag)
    {
        EditingPlace?.Tags.Remove(tag);
    }

    private async Task HandleGpxUploaded(GpxUploadResult result)
    {
        if (result.Success && EditingPlace != null)
        {
            try
            {
                // Parse the GPX file
                var gpxTrack = GpxService.ParseGpxContent(result.Content, result.FileName);
                gpxTrack.CreatedAt = DateTimeOffset.UtcNow;

                // Save the GPX track
                await GpxRepository.AddAsync(gpxTrack);

                // Link it to the place
                EditingPlace.GpxTrackId = gpxTrack.Id;

                // Reload GPX tracks
                await LoadGpxTracks();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error processing GPX file: {ex.Message}");
            }
        }
    }

    private void RemoveGpxTrack()
    {
        if (EditingPlace != null)
        {
            EditingPlace.GpxTrackId = null;
        }
    }


}
