@page "/chat"
@page "/chat/{ConversationId}"

@using Microsoft.AspNetCore.Authorization
@using TripPlanner.Web.Models
@using TripPlanner.Web.Repositories
@using TripPlanner.Web.Services

@attribute [Authorize]

@implements IDisposable

@inject IChatService ChatService
@inject IChatConversationRepository ConversationRepository
@inject IChatJobRepository ChatJobRepository
@inject UserService UserService
@inject BrowserTimeZoneService BrowserTimeZoneService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<ChatPage> Logger

<PageTitle>AI Assistant</PageTitle>

@* ─── Sidebar overlay backdrop (mobile) ─── *@
<div class="@(_showSidebar ? "chat-sidebar-overlay chat-sidebar-overlay--open" : "chat-sidebar-overlay")"
     role="button"
     tabindex="0"
     aria-label="Close conversations sidebar"
     @onclick="CloseSidebar"
     @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") { CloseSidebar(); } })">
</div>

<div class="chat-layout">

    @* ─── Sidebar ─── *@
    <div class="@(_showSidebar ? "chat-sidebar chat-sidebar--open" : "chat-sidebar")">
        <FluentNavMenu>
            <FluentNavLink Icon="@(new Icons.Filled.Size24.ChatAdd())" Href="/chat" @Tooltip="New Conversation" Match="NavLinkMatch.All" IconColor="Color.Accent">New Conversation</FluentNavLink>
            @foreach (var conv in _conversations)
            {
                <FluentNavLink Icon="@(new Icons.Regular.Size24.Chat())" Href="@($"/chat/{@conv.Id}")" @Tooltip="@conv.Title" IconColor="Color.Neutral">@conv.Title</FluentNavLink>
            }
        </FluentNavMenu>

    </div>

    @* ─── Chat panel ─── *@
    <div class="chat-panel">
        <FluentToolbar Style="flex-shrink: 0;">
            <FluentButton Appearance="Appearance.Stealth"
                          Class="chat-sidebar-toggle"
                          IconStart="@(new Icons.Regular.Size20.Navigation())"
                          Title="Conversations"
                          AriaLabel="Toggle conversations sidebar"
                          OnClick="@ToggleSidebar" />
            <FluentIcon Value="@(new Icons.Regular.Size24.Bot())" Color="Color.Accent" />
            <FluentLabel Typo="Typography.H3" Style="margin-left: 8px;">AI Trip Assistant</FluentLabel>
        </FluentToolbar>

        <div id="chat-messages" class="chat-messages">
            @if (!ChatService.Messages.Any() && _pendingUserMessage is null && !_isThinking)
            {
                <FluentStack Orientation="Orientation.Vertical"
                             HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalAlignment="VerticalAlignment.Center"
                             Style="flex: 1; opacity: 0.6;">
                    <FluentIcon Value="@(new Icons.Regular.Size48.Bot())" Color="Color.Neutral" />
                    <FluentLabel Typo="Typography.Body" Style="text-align: center;">
                        Ask me anything about your trips, wishlists, or places.<br />
                        I can list, create, update, and delete them for you.
                    </FluentLabel>
                </FluentStack>
            }

            @foreach (var msg in ChatService.Messages)
            {
                @if (msg.Role == "user")
                {
                    <div style="display: flex; justify-content: flex-end;">
                        <FluentCard Style="max-width: 85%; background: var(--accent-fill-rest); color: var(--foreground-on-accent-rest); padding: 10px 14px; border-radius: 12px 12px 4px 12px;">
                            <MarkdownSection Content="@msg.Content" />
                        </FluentCard>
                    </div>
                }
                else
                {
                    <div style="display: flex; justify-content: flex-start;">
                        <FluentCard Style="max-width: 90%; padding: 10px 14px; border-radius: 12px 12px 12px 4px;">
                            <MarkdownSection Content="@msg.Content" />
                        </FluentCard>
                    </div>
                }
            }

            @* Pending user message shown while the background job is running *@
            @if (_pendingUserMessage is not null && !ChatService.Messages.Any(m => m.Role == "user" && m.Content == _pendingUserMessage))
            {
                <div style="display: flex; justify-content: flex-end;">
                    <FluentCard Style="max-width: 85%; background: var(--accent-fill-rest); color: var(--foreground-on-accent-rest); padding: 10px 14px; border-radius: 12px 12px 4px 12px;">
                        <FluentLabel Style="color: inherit; white-space: pre-wrap; word-break: break-word;">@_pendingUserMessage</FluentLabel>
                    </FluentCard>
                </div>
            }

            @if (_isThinking)
            {
                <div style="display: flex; justify-content: flex-start;">
                    <FluentCard Style="padding: 10px 14px; border-radius: 12px 12px 12px 4px;">
                        <FluentStack Orientation="Orientation.Horizontal"
                                     VerticalAlignment="VerticalAlignment.Center"
                                     Style="gap: 8px;">
                            <FluentProgressRing Width="18px" />
                            <FluentLabel Style="font-style: italic; color: var(--neutral-foreground-hint);">Thinking…</FluentLabel>
                        </FluentStack>
                    </FluentCard>
                </div>
            }

            @* Error card shown when a job has failed, with a retry button *@
            @if (_jobError is not null)
            {
                <div style="display: flex; justify-content: flex-start;">
                    <FluentCard Style="max-width: 90%; padding: 10px 14px; border-radius: 12px 12px 12px 4px; border: 1px solid var(--error);">
                        <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px;">
                            <FluentStack Orientation="Orientation.Horizontal"
                                         VerticalAlignment="VerticalAlignment.Center"
                                         Style="gap: 8px;">
                                <FluentIcon Value="@(new Icons.Regular.Size20.ErrorCircle())" Color="Color.Error" />
                                <FluentLabel Style="color: var(--error);">An error occurred while processing your message.</FluentLabel>
                            </FluentStack>
                            <FluentButton Appearance="Appearance.Outline"
                                          IconStart="@(new Icons.Regular.Size20.ArrowClockwise())"
                                          OnClick="@RetryLastMessage"
                                          Style="align-self: flex-start;">
                                Retry
                            </FluentButton>
                        </FluentStack>
                    </FluentCard>
                </div>
            }
        </div>

        <FluentCard Class="chat-input-card">
            <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; align-items: flex-end;">
                <FluentTextArea @ref="_textAreaRef"
                                Value="@_userInput"
                                @oninput="OnTextAreaInput"
                                Placeholder="Ask me about your trips, wishlists, or places…"
                                Style="flex: 1; resize: none;"
                                Rows="1"
                                @onkeydown="HandleKeyDown"
                                Disabled="@_isThinking" />
                <FluentButton Appearance="Appearance.Accent"
                              OnClick="@SendMessage"
                              Disabled="@(_isThinking || string.IsNullOrWhiteSpace(_userInput))"
                              IconStart="@(new Icons.Regular.Size20.Send())"
                              Style="align-self: flex-end;"
                              AriaLabel="Send message">
                    <span class="chat-input-send-label">Send</span>
                </FluentButton>
            </FluentStack>
        </FluentCard>
    </div>
</div>

@code {
    [Parameter] public string? ConversationId { get; set; }

    private string _userInput = string.Empty;
    private bool _isThinking;
    private bool _showSidebar;
    private ApplicationUser? _currentUser;
    private List<ChatConversation> _conversations = [];
    private FluentTextArea? _textAreaRef;

    // Background job tracking
    private string? _activeJobId;
    private string? _pendingUserMessage;
    private string? _jobError;
    private CancellationTokenSource? _pollingCts;
    private bool _shouldScrollToBottom;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserService.GetCurrentUserAsync();
        if (_currentUser is not null)
            _conversations = await ConversationRepository.GetByUserAsync(_currentUser.Id);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_currentUser is null) return;

        bool sameConversation = string.Equals(ConversationId, ChatService.CurrentConversationId, StringComparison.OrdinalIgnoreCase);

        if (!sameConversation)
        {
            // Cancel any in-progress polling and clear stale job state from the previous conversation.
            _pollingCts?.Cancel();
            _pollingCts?.Dispose();
            _pollingCts = null;
            _activeJobId = null;
            _isThinking = false;
            _jobError = null;
            _pendingUserMessage = null;

            if (string.IsNullOrEmpty(ConversationId))
            {
                ChatService.Clear();
                return;
            }

            var loaded = await ChatService.LoadConversationAsync(ConversationId, _currentUser.Id);
            if (!loaded)
            {
                ChatService.Clear();
                Navigation.NavigateTo("/chat");
                return;
            }

            _shouldScrollToBottom = true;
        }

        // Restore thinking state if a job is still running. This runs even when sameConversation=true
        // to handle the case where the component was recreated by the navigation (e.g. after the first
        // message in a new chat) and therefore has no local state, even though ChatService already has
        // the correct CurrentConversationId.
        if (!string.IsNullOrEmpty(ConversationId) && _activeJobId is null)
        {
            var activeJob = await ChatJobRepository.GetActiveJobForConversationAsync(ConversationId, _currentUser.Id);
            if (activeJob is not null)
            {
                _activeJobId = activeJob.Id;
                _pendingUserMessage = activeJob.UserMessage;
                _isThinking = true;
                StartPolling();
                _shouldScrollToBottom = true;
            }
            else if (sameConversation && !ChatService.Messages.Any())
            {
                // The component was recreated for the same conversation (e.g. after first-message
                // navigation) but the job already completed before we could find it as active.
                // Load the conversation from DB so the persisted messages are visible immediately.
                await ChatService.LoadConversationAsync(ConversationId, _currentUser.Id);
                _shouldScrollToBottom = true;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await TrySetUserLocationAsync();
        }

        if (_shouldScrollToBottom)
        {
            _shouldScrollToBottom = false;
            await ScrollToBottomAsync();
        }
    }

    private async Task TrySetUserLocationAsync()
    {
        try
        {
            var location = await JS.InvokeAsync<LocationResult?>("chatInterop.getLocation");
            if (location is not null)
                ChatService.SetUserLocation(location.Latitude, location.Longitude);
        }
        catch
        {
            // Geolocation not available or denied — continue without it.
        }
    }

    private sealed class LocationResult
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || _currentUser is null || _isThinking) return;

        var message = _userInput.Trim();
        _userInput = string.Empty;
        _jobError = null;
        await ResetTextAreaHeightAsync();

        bool isNewConversation = ChatService.CurrentConversationId is null;

        // Ensure a conversation exists before creating the job so we have a ConversationId.
        if (isNewConversation)
        {
            var title = message.Length > 80 ? message[..77] + "…" : message;
            var conversation = await ConversationRepository.CreateAsync(_currentUser.Id, title);
            ChatService.SetCurrentConversationId(conversation.Id);
        }

        var conversationId = ChatService.CurrentConversationId
            ?? throw new InvalidOperationException("Conversation ID is null after creation.");

        // Save the user message to the database so the background service can load it.
        await ConversationRepository.AddMessageAsync(conversationId, "user", message, _currentUser.Id);

        // Create the background job.
        var job = await ChatJobRepository.CreateAsync(conversationId, _currentUser.Id, message, BrowserTimeZoneService.LanguageTag);
        _activeJobId = job.Id;
        _pendingUserMessage = message;
        _isThinking = true;
        _shouldScrollToBottom = true;

        if (isNewConversation)
        {
            // Refresh the sidebar so the new conversation appears immediately.
            _conversations = await ConversationRepository.GetByUserAsync(_currentUser.Id);
            // Navigate only after the job and message are persisted. This way, if Blazor recreates the
            // component for the new route, OnParametersSetAsync can restore the pending state from DB.
            Navigation.NavigateTo($"/chat/{conversationId}", replace: true);
        }

        StateHasChanged();
        StartPolling();
    }

    private void StartPolling()
    {
        var previousCts = _pollingCts;
        previousCts?.Cancel();
        previousCts?.Dispose();
        _pollingCts = new CancellationTokenSource();
        _ = PollJobStatusAsync(_pollingCts.Token);
    }

    private async Task PollJobStatusAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested && _activeJobId is not null)
        {
            try
            {
                await Task.Delay(3000, ct);
            }
            catch (OperationCanceledException)
            {
                break;
            }

            if (ct.IsCancellationRequested) break;

            try
            {
                var job = await ChatJobRepository.GetByIdAsync(_activeJobId, _currentUser!.Id);
                if (job is null) break;

                if (job.Status == ChatJobStatus.Completed)
                {
                    await InvokeAsync(async () =>
                    {
                        await OnJobCompletedAsync();
                        StateHasChanged();
                    });
                    break;
                }
                else if (job.Status == ChatJobStatus.Failed)
                {
                    await InvokeAsync(() =>
                    {
                        _jobError = job.ErrorMessage ?? "An error occurred.";
                        _activeJobId = null;
                        _isThinking = false;
                        StateHasChanged();
                        return Task.CompletedTask;
                    });
                    break;
                }
            }
            catch (Exception ex) when (!ct.IsCancellationRequested)
            {
                Logger.LogWarning(ex, "Error polling chat job {JobId}.", _activeJobId);
            }
        }
    }

    private async Task OnJobCompletedAsync()
    {
        _activeJobId = null;
        _isThinking = false;

        // Reload the conversation from the database to show the AI response.
        if (_currentUser is not null && ChatService.CurrentConversationId is not null)
        {
            await ChatService.LoadConversationAsync(ChatService.CurrentConversationId, _currentUser.Id);
            _pendingUserMessage = null;
            _conversations = await ConversationRepository.GetByUserAsync(_currentUser.Id);
        }

        _shouldScrollToBottom = true;
    }

    private async Task RetryLastMessage()
    {
        if (_pendingUserMessage is null || _currentUser is null || ChatService.CurrentConversationId is null) return;

        _jobError = null;
        _isThinking = true;

        var job = await ChatJobRepository.CreateAsync(ChatService.CurrentConversationId, _currentUser.Id, _pendingUserMessage, BrowserTimeZoneService.LanguageTag);
        _activeJobId = job.Id;
        StateHasChanged();

        StartPolling();
    }

    private async Task OnTextAreaInput(ChangeEventArgs e)
    {
        _userInput = e.Value?.ToString() ?? string.Empty;
        await AutoResizeTextAreaAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !_isThinking)
            await SendMessage();
    }

    private void ToggleSidebar() => _showSidebar = !_showSidebar;

    private void CloseSidebar() => _showSidebar = false;

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("chatInterop.scrollToBottom", "chat-messages");
        }
        catch
        {
            // Ignore JS interop errors (e.g. during prerendering)
        }
    }

    private async Task AutoResizeTextAreaAsync()
    {
        try
        {
            if (_textAreaRef?.Element is { } el)
                await JS.InvokeVoidAsync("chatInterop.autoResizeTextArea", el);
        }
        catch
        {
            // Ignore JS interop errors (e.g. during prerendering)
        }
    }

    private async Task ResetTextAreaHeightAsync()
    {
        try
        {
            if (_textAreaRef?.Element is { } el)
                await JS.InvokeVoidAsync("chatInterop.resetTextAreaHeight", el);
        }
        catch
        {
            // Ignore JS interop errors (e.g. during prerendering)
        }
    }

    public void Dispose()
    {
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
    }
}

