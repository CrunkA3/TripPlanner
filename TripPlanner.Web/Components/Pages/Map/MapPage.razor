@page "/map"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using TripPlanner.Web.Models
@using TripPlanner.Web.Repositories
@using TripPlanner.Web.Services
@using Microsoft.JSInterop
@using TripPlanner.Web.Components.Shared

@inject IPlaceRepository PlaceRepository
@inject ITripRepository TripRepository
@inject IGpxRepository GpxRepository
@inject IJSRuntime JSRuntime
@inject UserService UserService
@inject IDialogService DialogService
@inject WeatherService WeatherService

@attribute [Authorize]

@implements IAsyncDisposable

<PageTitle>Map View</PageTitle>
<FluentDialogProvider />

    

<!-- Map Container -->
<div id="map-container" style="width: 100%; height: 100%;">
    <div id="map" style="height:100%; width:100%;"></div>

    <FluentToolbar style="position: absolute; top: 6px; left: 6px; max-width: calc(100% - min(320px, 50%) - 18px); max-height: 25%;">
        <FluentSelect TOption="string" @bind-Value="@SelectedTripId" Style="width:100%; min-width:50px;">
            <FluentOption TOption="string" Value="@string.Empty">All Trips</FluentOption>
            @foreach (var trip in Trips)
            {
                <FluentOption TOption="string" Value="@trip.Id">@trip.Name</FluentOption>
            }
        </FluentSelect>
        <FluentSelect TOption="string" Value="@SelectedWeatherDayStr" ValueChanged="@OnWeatherDayChanged" Disabled="@(!ShowWeather)" Style="width:100%; min-width:50px;">
            @for (int i = 0; i < 7; i++)
            {
                var day = i;
                var date = DateTime.Today.AddDays(day);
                var label = day == 0 ? "Today" : day == 1 ? "Tomorrow" : date.ToString("ddd, MMM d");
                <FluentOption TOption="string" Value="@day.ToString()">@label</FluentOption>
            }
        </FluentSelect>

        <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size20.ArrowSync())" OnClick="@LoadMapData" aria-label="refresh map" />
        <FluentButton Appearance="@(ShowWishlist ? Appearance.Accent : Appearance.Outline)" IconStart="@(new Icons.Regular.Size20.Heart())" OnClick="@(() => ShowWishlist = !ShowWishlist)" aria-label="toggle show wishlist" />
        <FluentButton Appearance="@(ShowGpxTracks ? Appearance.Accent : Appearance.Outline)" IconStart="@(new Icons.Regular.Size20.MountainTrail())" OnClick="@(() => ShowGpxTracks = !ShowGpxTracks)" aria-label="toggle show gpx tracks" />
        <FluentButton Appearance="@(ShowRoutes ? Appearance.Accent : Appearance.Outline)" IconStart="@(new Icons.Regular.Size20.Road())" OnClick="@(() => ShowRoutes = !ShowRoutes)" aria-label="toggle show routes" />
        <FluentButton Appearance="@(ShowWeather ? Appearance.Accent : Appearance.Outline)" IconStart="@(new Icons.Regular.Size20.WeatherHailDay())" OnClick="@(() => ShowWeather = !ShowWeather)" aria-label="toggle show weather" />
    </FluentToolbar>


    <!-- Side Panel -->
    <div style="position: absolute; top: 6px; right: 6px; width: min(320px, 50%); max-height: calc(100% - 12px - 40px); overflow: auto;">

        @if (isLandscape)
        {
            <FluentStack Orientation="Orientation.Vertical" Style="max-height:100%;">
                @foreach (var place in VisibleWishlistPlaces)
                {
                    var weather = WeatherByPlaceId.GetValueOrDefault(place.Id);
                    <FluentCard>
                        <FluentStack Orientation="Orientation.Vertical">
                            <FluentLabel Weight="FontWeight.Bold">@place.Name</FluentLabel>
                            <FluentBadge BackgroundColor="var(--neutral-layer-3)">@place.Category</FluentBadge>
                            <FluentLabel Style="font-size: 0.875em;">
                                @place.Latitude.ToString("F4"), @place.Longitude.ToString("F4")
                            </FluentLabel>
                            @if (ShowWeather && weather != null)
                            {
                                <FluentLabel Style="font-size: 0.875em;" title="@weather.GetDescription()">
                                    @weather.GetSummary()
                                </FluentLabel>
                            }
                        </FluentStack>
                    </FluentCard>
                }
            </FluentStack>
        }
        else
        {
            <FluentHorizontalScroll Speed="600" Easing=ScrollEasing.EaseInOut>
                @foreach (var place in VisibleWishlistPlaces)
                {
                    var weather = WeatherByPlaceId.GetValueOrDefault(place.Id);
                    <FluentCard Style="height:150px;width: 150px;">
                        <FluentStack Orientation="Orientation.Vertical">
                            <FluentLabel Weight="FontWeight.Bold">@place.Name</FluentLabel>
                            <FluentBadge BackgroundColor="var(--neutral-layer-3)">@place.Category</FluentBadge>
                            <FluentLabel Style="font-size: 0.875em;">
                                @place.Latitude.ToString("F4"), @place.Longitude.ToString("F4")
                            </FluentLabel>
                            @if (ShowWeather && weather != null)
                            {
                                <FluentLabel Style="font-size: 0.875em;" title="@weather.GetDescription()">
                                    @weather.GetSummary()
                                </FluentLabel>
                            }
                        </FluentStack>
                    </FluentCard>
                }
            </FluentHorizontalScroll>
        }
     
        <FluentStack Orientation="Orientation.Vertical">
            @foreach (var tripPlace in VisibleTripPlaces)
            {
                @if (tripPlace.Place != null)
                {
                    var weather = WeatherByPlaceId.GetValueOrDefault(tripPlace.Place.Id);
                    <FluentCard>
                        <FluentStack Orientation="Orientation.Vertical">
                            <FluentLabel Weight="FontWeight.Bold">@tripPlace.Place.Name</FluentLabel>
                            @if (tripPlace.ScheduledTime.HasValue)
                            {
                                <FluentLabel Style="font-size: 0.875em;">
                                    <FluentIcon Icon="Icons.Regular.Size12.Clock" />
                                    @tripPlace.ScheduledTime.Value.ToString("HH:mm")
                                </FluentLabel>
                            }
                            <FluentLabel Style="font-size: 0.875em;">
                                @tripPlace.Place.Latitude.ToString("F4"), @tripPlace.Place.Longitude.ToString("F4")
                            </FluentLabel>
                            @if (ShowWeather && weather != null)
                            {
                                <FluentLabel Style="font-size: 0.875em;" title="@weather.GetDescription()">
                                    @weather.GetSummary()
                                </FluentLabel>
                            }
                        </FluentStack>
                    </FluentCard>
                }
            }
        </FluentStack>
    </div>

    @*     <FluentAccordion Style="position: absolute; top: 6px; right: 6px; width: min(320px, 50%); max-height: calc(100% - 12px);">
        @if (VisibleWishlistPlaces.Any() || VisibleTripPlaces.Any())
        {
            <FluentAccordionItem Heading="Places" Expanded="true" Style="max-height: 100%;">
               
            </FluentAccordionItem>
        }
    </FluentAccordion>
 *@    
</div>

@code {
    private List<Place> Places { get; set; } = new();
    private List<Trip> Trips { get; set; } = new();
    private List<GpxTrack> GpxTracks { get; set; } = new();
    private List<TripPlace> SelectedTripPlaces { get; set; } = new();
    private string SelectedTripId { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = true;
    private bool ShowWishlist { get; set; } = true;
    private bool ShowRoutes { get; set; } = true;
    private bool ShowGpxTracks { get; set; } = true;
    private bool MapInitialized { get; set; }
    private ApplicationUser? CurrentUser { get; set; }
    private DotNetObjectReference<MapPage>? _dotNetRef;
    private int SelectedWeatherDay { get; set; } = 0;
    private string SelectedWeatherDayStr { get; set; } = "0";
    private Dictionary<string, DailyWeather> WeatherByPlaceId { get; set; } = new();
    private CancellationTokenSource? _weatherCts;
    private bool ShowWeather { get; set; } = true;

    private bool isLandscape = true;

    private bool _boundsKnown;
    private double _boundsNorth;
    private double _boundsSouth;
    private double _boundsEast;
    private double _boundsWest;

    private List<Place>? _visibleWishlistPlaces;
    private List<TripPlace>? _visibleTripPlaces;

    private List<Place> VisibleWishlistPlaces => _visibleWishlistPlaces ??= ComputeVisiblePlaces();
    private List<TripPlace> VisibleTripPlaces => _visibleTripPlaces ??= ComputeVisibleTripPlaces();


    private List<Place> ComputeVisiblePlaces() =>
        _boundsKnown
            ? Places.Where(p => IsInBounds(p.Latitude, p.Longitude)).ToList()
            : Places;

    private List<TripPlace> ComputeVisibleTripPlaces() =>
        _boundsKnown
            ? SelectedTripPlaces.Where(tp => tp.Place != null && IsInBounds(tp.Place.Latitude, tp.Place.Longitude)).ToList()
            : SelectedTripPlaces;

    private void InvalidateVisiblePlaces()
    {
        _visibleWishlistPlaces = null;
        _visibleTripPlaces = null;
    }

    private bool IsInBounds(double lat, double lng)
    {
        if (lat < _boundsSouth || lat > _boundsNorth) return false;
        // Handle antimeridian crossing (west > east when map spans the date line)
        return _boundsWest <= _boundsEast
            ? lng >= _boundsWest && lng <= _boundsEast
            : lng >= _boundsWest || lng <= _boundsEast;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMapData();
        await LoadWeather();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Get initial orientation
        var orientation = await JSRuntime.InvokeAsync<string>("screenOrientationHelper.getOrientation");
        isLandscape = orientation.StartsWith("landscape");


        if (firstRender)
        {
            await InitializeMap();
            await UpdateMapContent();


            // Listen for changes
            await JSRuntime.InvokeVoidAsync("screenOrientationHelper.onOrientationChange", DotNetObjectReference.Create(this));
        }
    }

    private async Task InitializeMap()
    {
        try
        {
            double centerLat = 48.8566, centerLng = 2.3522;
            int zoom = 6;
            if (CurrentUser?.HomeLatitude.HasValue == true && CurrentUser?.HomeLongitude.HasValue == true)
            {
                centerLat = CurrentUser.HomeLatitude.Value;
                centerLng = CurrentUser.HomeLongitude.Value;
                zoom = 10;
            }
            await JSRuntime.InvokeVoidAsync("mapInterop.initializeMap", "map", centerLat, centerLng, zoom);
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("mapInterop.setDotNetRef", _dotNetRef);
            await JSRuntime.InvokeVoidAsync("mapInterop.registerBoundsCallback", _dotNetRef, "OnBoundsChanged");
            MapInitialized = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error initializing map: {ex.Message}");
        }
    }

    private async Task LoadMapData()
    {
        IsLoading = true;

        CurrentUser = await UserService.GetCurrentUserAsync();

        if (CurrentUser is not null)
        {
            Places = (await PlaceRepository.GetAllByUserAsync(CurrentUser.Id)).Where(x => x.Latitude != 0 && x.Longitude != 0).ToList();
            var ownedTrips = await TripRepository.GetByOwnerAsync(CurrentUser.Id);
            var sharedTrips = await TripRepository.GetSharedWithUserAsync(CurrentUser.Id);
            Trips = ownedTrips.UnionBy(sharedTrips, t => t.Id).ToList();
            GpxTracks = await GpxRepository.GetAllByUserAsync(CurrentUser.Id);
        }
        
        if (!string.IsNullOrEmpty(SelectedTripId))
        {
            var selectedTrip = Trips.FirstOrDefault(t => t.Id == SelectedTripId);
            if (selectedTrip != null)
            {
                SelectedTripPlaces = selectedTrip.Days
                    .SelectMany(d => d.Places)
                    .ToList();
                
                // Load place details
                foreach (var tripPlace in SelectedTripPlaces)
                {
                    tripPlace.Place = Places.FirstOrDefault(p => p.Id == tripPlace.PlaceId);
                }
            }
        }
        else
        {
            SelectedTripPlaces.Clear();
        }
        
        IsLoading = false;
        InvalidateVisiblePlaces();

        if (MapInitialized)
        {
            await UpdateMapContent();
        }
    }

    private async Task OnWeatherDayChanged(string value)
    {
        SelectedWeatherDayStr = value;
        SelectedWeatherDay = int.TryParse(value, out var d) ? d : 0;
        await LoadWeather();
    }

    private async Task OnShowWeatherChanged(bool value)
    {
        ShowWeather = value;
        await UpdateMapContent();
    }

    private async Task LoadWeather()
    {
        // Cancel any in-flight weather load so stale results never overwrite fresher ones.
        _weatherCts?.Cancel();
        _weatherCts?.Dispose();
        var cts = new CancellationTokenSource();
        _weatherCts = cts;
        var token = cts.Token;

        var targetDate = DateOnly.FromDateTime(DateTime.Today.AddDays(SelectedWeatherDay));
        WeatherByPlaceId.Clear();

        var allLocations = Places
            .Select(p => (id: p.Id, lat: p.Latitude, lon: p.Longitude))
            .Concat(SelectedTripPlaces
                .Where(tp => tp.Place != null)
                .Select(tp => (id: tp.Place!.Id, lat: tp.Place.Latitude, lon: tp.Place.Longitude)))
            .DistinctBy(x => x.id)
            .ToList();

        var tasks = allLocations.Select(async loc =>
        {
            var weather = await WeatherService.GetWeatherForDateAsync(loc.lat, loc.lon, targetDate);
            return (loc.id, weather);
        });

        var results = await Task.WhenAll(tasks);

        // A newer LoadWeather call was started; discard these results.
        if (token.IsCancellationRequested)
            return;

        foreach (var (id, weather) in results)
        {
            if (weather != null)
                WeatherByPlaceId[id] = weather;
        }

        StateHasChanged();

        if (MapInitialized)
        {
            await UpdateMapContent();
        }
    }

    private async Task UpdateMapContent()
    {
        if (!MapInitialized) return;

        try
        {
            // Clear existing map content
            await JSRuntime.InvokeVoidAsync("mapInterop.clearMarkers");
            await JSRuntime.InvokeVoidAsync("mapInterop.clearRoutes");
            await JSRuntime.InvokeVoidAsync("mapInterop.clearGpxTracks");

            // Add home location marker
            if (CurrentUser?.HomeLatitude.HasValue == true && CurrentUser?.HomeLongitude.HasValue == true)
            {
                await JSRuntime.InvokeVoidAsync("mapInterop.addHomeMarker",
                    CurrentUser.HomeLatitude.Value, CurrentUser.HomeLongitude.Value,
                    CurrentUser.HomeLocationName ?? "Home");
            }

            // Add markers for wishlist places
            if (ShowWishlist)
            {
                foreach (var place in Places)
                {
                    var color = IPlaceRepository.GetCategoryColor(place.Category);
                    var weatherInfo = ShowWeather && WeatherByPlaceId.TryGetValue(place.Id, out var w) ? w.GetSummary() : null;
                    await JSRuntime.InvokeVoidAsync("mapInterop.addMarker",
                        place.Id, place.Latitude, place.Longitude,
                        place.Name, place.Category.ToString(), color, weatherInfo);
                }
            }

            // Add routes and markers for selected trip
            if (!string.IsNullOrEmpty(SelectedTripId) && ShowRoutes)
            {
                var selectedTrip = Trips.FirstOrDefault(t => t.Id == SelectedTripId);
                if (selectedTrip != null)
                {
                    foreach (var day in selectedTrip.Days.OrderBy(d => d.DayNumber))
                    {
                        var dayPlaces = day.Places.OrderBy(p => p.Order).ToList();
                        if (dayPlaces.Count > 1)
                        {
                            var coordinates = dayPlaces
                                .Where(tp => tp.Place != null)
                                .Select(tp => new { latitude = tp.Place!.Latitude, longitude = tp.Place.Longitude })
                                .ToList();
                            
                            if (coordinates.Any())
                            {
                                await JSRuntime.InvokeVoidAsync("mapInterop.addRoute", coordinates, "#FF5722", 3);
                            }
                        }
                    }
                }
            }

            // Add GPX tracks
            if (ShowGpxTracks)
            {
                foreach (var gpxTrack in GpxTracks)
                {
                    if (gpxTrack.Points.Any())
                    {
                        var points = gpxTrack.Points.Select(p => new { latitude = p.Latitude, longitude = p.Longitude }).ToList();
                        await JSRuntime.InvokeVoidAsync("mapInterop.addGpxTrack", points, "#9C27B0");
                    }
                }
            }

            // Fit map to show all content
            await JSRuntime.InvokeVoidAsync("mapInterop.fitBounds");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating map content: {ex.Message}");
        }
    }


    [JSInvokable]
    public async Task OnBoundsChanged(double north, double south, double east, double west)
    {
        _boundsNorth = north;
        _boundsSouth = south;
        _boundsEast = east;
        _boundsWest = west;
        _boundsKnown = true;
        InvalidateVisiblePlaces();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnOrientationChanged(string newOrientation)
    {
        isLandscape = newOrientation.StartsWith("landscape");
        StateHasChanged();
        await UpdateMapContent();
    }

    [JSInvokable]
    public async Task OnViewPlace(string placeId)
    {
        var place = Places.FirstOrDefault(p => p.Id == placeId)
            ?? SelectedTripPlaces.FirstOrDefault(tp => tp.PlaceId == placeId)?.Place;
        if (place is null) return;

        await DialogService.ShowDialogAsync<PlaceDialog>(place, new DialogParameters()
        {
            Title = place.Name,
            Width = "600px"
        });
    }

    public async ValueTask DisposeAsync()
    {
        _weatherCts?.Cancel();
        _weatherCts?.Dispose();
        _dotNetRef?.Dispose();
        if (MapInitialized)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("mapInterop.destroyMap");
            }
            catch { }
        }
    }
}
