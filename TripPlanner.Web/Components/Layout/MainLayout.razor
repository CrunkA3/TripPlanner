@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject BrowserTimeZoneService BrowserTimeZoneService
@inject NavigationManager Navigation
@implements IDisposable

@if (_isInteractive)
{
    <span id="blazor-interactive" style="display:none;" aria-hidden="true"></span>
}

<FluentLayout>
    <FluentHeader>
        <FluentStack>
            TripPlanner

            <AuthorizeView>
                <FluentSpacer />
                <FluentAnchor Href="Account/Manage"
                              IconStart="@(new Icons.Regular.Size24.Person().WithColor(Color.Fill))" 
                              Appearance="Appearance.Outline" 
                              aria-label="Account"/>
            </AuthorizeView>
        </FluentStack>
    </FluentHeader>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <div class="@GetContentClass()">
                @Body
            </div>
        </FluentBodyContent>
        <FluentMenuProvider />

    </FluentStack>
    <FluentFooter>
        <FluentSpacer />
        <a href="/privacy">Privacy Policy</a>
    </FluentFooter>
</FluentLayout>

<CookieConsent />



<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isInteractive;

    private string GetContentClass()
    {
        var uri = new Uri(Navigation.Uri);
        var isFullScreen = uri.AbsolutePath.StartsWith("/map", StringComparison.OrdinalIgnoreCase);
        return isFullScreen ? "content content-fullscreen" : "content";
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isInteractive = true;
            StateHasChanged();

            try
            {
                var timezone = await JS.InvokeAsync<string>("browserInfo.getTimezone");
                BrowserTimeZoneService.SetTimeZone(timezone);
                var culture = await JS.InvokeAsync<string>("browserInfo.getCulture");
                BrowserTimeZoneService.SetLanguage(culture);
            }
            catch
            {
                // Ignore JS interop errors during prerendering or if JS is unavailable
            }
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
