                <line x1="268" y1="450" x2="255" y2="431" />
                <line x1="332" y1="450" x2="345" y2="431" />
                <line x1="248" y1="470" x2="228" y2="458" />
                <line x1="352" y1="470" x2="372" y2="458" />
                <line x1="240" y1="494" x2="218" y2="490" />
                <line x1="360" y1="494" x2="382" y2="490" />
            </g>
            <!-- Far mountains (purple silhouette) -->
            <path d="M0 450 L48 348 L78 368 L110 296 L144 335 L184 260 L230 316 L270 246 L310 296 L354 256 L394 300 L434 265 L474 310 L514 276 L554 316 L600 288 L600 510 L0 510 Z" fill="url(#reg-mtn-far)" opacity="0.85" />
