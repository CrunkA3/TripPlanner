            <path d="M270 246 L286 268 L294 286 L278 270 Z" fill="#FFE0B0" opacity="0.65" />
            <path d="M354 256 L370 278 L378 294 L362 278 Z" fill="#FFE0B0" opacity="0.65" />
            <path d="M434 265 L450 286 L458 302 L442 286 Z" fill="#FFE0B0" opacity="0.65" />
            <!-- Mid mountains (forest green) -->
            <path d="M0 510 L24 438 L60 468 L90 408 L130 448 L170 382 L210 428 L250 368 L294 414 L334 378 L374 422 L414 388 L454 428 L494 392 L538 432 L578 402 L600 428 L600 576 L0 576 Z" fill="url(#reg-mtn-mid)" />
            <!-- Pine tree silhouette foreground -->
            <path d="M0 576 L0 536 L12 554 L12 524 L22 544 L22 518 L32 536 L37 514 L46 532 L52 508 L62 528 L68 502 L78 524 L85 499 L95 520 L104 496 L110 518 L120 493 L128 515 L137 491 L145 513 L154 489 L163 512 L172 487 L182 510 L191 485 L200 508 L210 483 L219 507 L228 482 L237 506 L247 480 L256 504 L266 478 L275 502 L285 476 L294 500 L304 474 L313 498 L323 472 L332 496 L342 470 L351 494 L361 468 L370 492 L380 466 L389 490 L399 464 L408 488 L418 462 L427 486 L437 460 L446 484 L456 458 L465 482 L475 456 L484 480 L494 454 L503 478 L513 452 L522 476 L532 450 L541 474 L551 448 L560 472 L570 446 L579 470 L589 444 L600 468 L600 576 Z" fill="url(#reg-mtn-near)" />
            <!-- Ground -->
            <rect x="0" y="576" width="600" height="224" fill="#060B05" />
            <!-- Trail path -->
            <path class="auth-trail" d="M300 800 Q316 750 290 698 Q270 654 298 614 Q324 580 306 548 Q293 520 314 496" stroke="#E8844A" stroke-width="2.5" fill="none" opacity="0.75" stroke-dasharray="7 5" stroke-linecap="round" />
            <!-- Trail runner silhouette -->
            <g transform="translate(312,492)" fill="#E8844A" opacity="0.9">
