            <circle class="auth-star-c" cx="135" cy="22" r="0.8" fill="white" opacity="0.5" />
            <circle class="auth-star-a" cx="215" cy="58" r="0.9" fill="white" opacity="0.55" />
            <circle class="auth-star-d" cx="318" cy="28" r="1.2" fill="white" opacity="0.65" />
            <circle class="auth-star-b" cx="405" cy="48" r="0.8" fill="white" opacity="0.5" />
            <circle class="auth-star-c" cx="462" cy="18" r="1.0" fill="white" opacity="0.55" />
            <circle class="auth-star-a" cx="538" cy="42" r="0.7" fill="white" opacity="0.5" />
            <circle class="auth-star-d" cx="82" cy="88" r="0.8" fill="white" opacity="0.4" />
            <circle class="auth-star-b" cx="172" cy="76" r="0.9" fill="white" opacity="0.45" />
            <circle class="auth-star-c" cx="375" cy="70" r="1.0" fill="white" opacity="0.5" />
            <!-- Sun glow (horizon) -->
